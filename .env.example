# Пример переменных окружения для Next.js.
# Добавляйте сюда только те переменные, которые реально используются в проекте.
# Например:
# NEXT_PUBLIC_API_URL="https://api.example.com"
# Site URLs — defaults live in config/domains.mjs (change domain once there).
# Env overrides still win when set.
NEXT_PUBLIC_SITE_URL="https://www.bober-systems.ru"
# White-label partner landing (partners.bober-systems.ru → /white-label via Caddy host rewrite)
NEXT_PUBLIC_PARTNERS_SITE_URL="https://partners.bober-systems.ru"
# Bitrix24 + amoCRM landing (bitrix.bober-systems.ru → /bitrix via Caddy host rewrite)
NEXT_PUBLIC_BITRIX_SITE_URL="https://bitrix.bober-systems.ru"
NEXT_PUBLIC_AMOCRM_SITE_URL="https://amocrm.bober-systems.ru"
NEXT_PUBLIC_YANDEX_METRIKA_ID="110635302"
# Google Search Console: код из «Подтверждение права собственности → HTML-тег» (content="...").
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION="..."
# IndexNow: ключ совпадает с именем файла public/<key>.txt (по умолчанию зашит в scripts/indexnow-submit.mjs).
# INDEXNOW_KEY="e12776ff43264f8c1750c9e433a90357"
# INDEXNOW_SITE_URL="https://www.bober-systems.ru"
NEXT_PUBLIC_PARTNERS_YANDEX_METRIKA_ID="110926696"
NEXT_PUBLIC_BITRIX_YANDEX_METRIKA_ID="110926887"
# amoCRM microsite: no dedicated counter yet — leave empty to reuse the main one
NEXT_PUBLIC_AMOCRM_YANDEX_METRIKA_ID=""
# Публичный email на сайте (mailto, футер, Schema):
NEXT_PUBLIC_CONTACT_EMAIL="contact@bober-systems.ru"
# Booking calendar for A/B CTA → schedule (Yandex Calendar / Calendly / etc.). Empty = form-only CTA.
# NEXT_PUBLIC_CALENDAR_URL="https://calendar.yandex.ru/..."

# Форма заявки (SMTP)
# Yandex 360 / Яндекс Почта:
#   SMTP_HOST="smtp.yandex.ru"
#   SMTP_PORT="465"
#   SMTP_SECURE="1"
#   SMTP_USER="you@yandex.ru"
#   SMTP_PASS="app-password"
#   CONTACT_FROM_EMAIL="you@yandex.ru"
# Selectel SMTP relay:
#   SMTP_HOST="smtp.mail.selcloud.ru"
#   SMTP_PORT="1127"
#   SMTP_SECURE="1"
# VDS (Selectel): smtp.mail.selcloud.ru:1127. Yandex SMTP from VDS usually blocked.
# Production: SMTP_* + CONTACT_* come from GitHub Actions secrets on each selectel-build deploy
# (see .github/workflows/selectel-build.yml). Host durable file: /opt/bober-ai/deploy/.env
SMTP_HOST=""
SMTP_PORT="1127"
SMTP_SECURE="1"
SMTP_USER=""
SMTP_PASS=""
CONTACT_FROM_EMAIL=""
# Куда слать заявки (через запятую). Если пусто — используется NEXT_PUBLIC_CONTACT_EMAIL.
# CONTACT_TO_EMAIL="contact@bober-systems.ru"
# Несколько получателей: CONTACT_TO_EMAIL="contact@bober-systems.ru,admin@example.com"
# CONTACT_DRY_RUN=1  — локально не шлёт почту (только лог). На VDS должно быть выключено.
# Опционально: лог лидов на диск и Telegram-уведомление
# На VDS: /app/data/leads.jsonl (volume leads_data).
# LEADS_LOG_PATH="/app/data/leads.jsonl"
# CONTACT_SKIP_SMTP=1 — принудительно без SMTP (только Telegram/Bitrix/лог).
# Deploy injects CONTACT_SKIP_SMTP=0 whenever SMTP_PASS secret is set.
# CONTACT_SKIP_SMTP=1
# CONTACT_TELEGRAM_BOT_TOKEN=""
# CONTACT_TELEGRAM_CHAT_ID=""
# Alias for owner DM on booking/handoff:
# TELEGRAM_OWNER_CHAT_ID=""

# Telegram Business / Chat Automation — бот отвечает от личного профиля (Grammy + history DB)
# 1) @BotFather → новый бот → TELEGRAM_BUSINESS_BOT_TOKEN
# 2) npm run telegram:business:setup  (ставит webhook на /api/telegram/business)
# 3) Telegram → Настройки → Telegram Business → Чат-боты → добавить @бота
# TELEGRAM_BUSINESS_BOT_TOKEN=""
# TELEGRAM_BUSINESS_WEBHOOK_SECRET=""
# Webhook host must be able to call api.telegram.org (Selectel RU often blocked).
# TELEGRAM_BUSINESS_WEBHOOK_URL="https://bober-ai-production.up.railway.app/api/telegram/business"
# Optional Bot API proxy root if the runtime host cannot reach api.telegram.org:
# TELEGRAM_API_BASE="https://api.telegram.org"
# OPENROUTER_API_KEY=""
# TELEGRAM_BUSINESS_LLM_MODEL="deepseek/deepseek-v4-flash-0731"
# TELEGRAM_BUSINESS_LLM_ENDPOINT="https://openrouter.ai/api/v1/chat/completions"
# Message history for LLM (Grammy bot). Prefer Postgres on Railway (durable):
# DATABASE_URL="postgresql://user:pass@host:5432/railway"
# Fallback SQLite file (ephemeral on Railway disk unless volume; OK for MVP):
# TELEGRAM_DB_PATH="data/telegram-bot.sqlite"
# TELEGRAM_HISTORY_LIMIT="20"
# TELEGRAM_CRM_DEBUG=1
# Reminders (every 3 days, random 20:00–22:00 Europe/Moscow). Default ON after chat.
# TELEGRAM_REMINDER_CRON_SECRET=""   # Bearer for POST /api/telegram/reminders/tick
# TELEGRAM_REMINDER_TICK_MS="900000" # in-process interval (ms), default 15m
# TELEGRAM_REMINDERS_DISABLED=1      # kill in-process scheduler
# TELEGRAM_CELEBRATION=1             # opt-in party-popper message_effect on bot replies (default OFF)
# TELEGRAM_CELEBRATION_EFFECT_ID=""  # override party-popper effect id (default 5046509860389126442)
# TELEGRAM_SMART_REACTIONS=0         # disable contextual reactions on client messages
# TELEGRAM_SMART_REACTIONS_LLM=0     # heuristics-only soft fallback (skip context LLM)
# TELEGRAM_REACTION_LLM_MODEL=""     # optional cheap model for reaction label
# GitHub Action backup: secrets TELEGRAM_REMINDER_CRON_SECRET + optional TELEGRAM_REMINDER_TICK_URL
#
# Client-tailored research sources (RU: источники подсказок клиентам по теме диалога).
# Not optional fluff — bot polls these and picks best match per client topics.
# EN: RSS feeds + SearXNG power news tips and live-chat web fallback.
# SEARXNG_URL="https://searxng-production.up.railway.app"
#   Live chat: if Bober knowledge insufficient → SearX; reply must say unverified web info.
#   News tick: SearX ON by default when this URL is set (TELEGRAM_NEWS_SEARX=0 to disable).
# TELEGRAM_RSS_FEEDS="https://habr.com/ru/rss/hub/crm/all/?fl=ru,https://www.cnews.ru/inc/rss/news.xml"
#   Optional override. Default in code: Habr AI/1C/CRM + CNews + Bitrix24 news.
# TELEGRAM_NEWS_ALERTS_PER_DAY="2"
# TELEGRAM_NEWS_ALERTS_DISABLED=1
# TELEGRAM_NEWS_SEARX=1   # explicit ON (default anyway if SEARXNG_URL set); 0 = news tick without SearX
# Яндекс 360 — корпоративная почта (Яндекс Бизнес)
# OAuth: https://yandex.ru/dev/api360/doc/ru/access
# Права: directory:read_organization, directory:read_domains, directory:read_users, directory:write_users
# YANDEX_360_OAUTH_TOKEN=""
# YANDEX_360_CLIENT_ID=""
# YANDEX_360_CLIENT_SECRET=""
# YANDEX_360_ORG_ID=""
# YANDEX_360_DOMAIN="bober-systems.ru"
# YANDEX_360_MAILBOX_NICKNAME="contact"
# Shared mailbox ACL: npm run yandex360:mailbox -- shared-create
# Needs OAuth scopes: ya360_admin:mail_read_shared_mailbox_inventory,
# ya360_admin:mail_write_shared_mailbox_inventory (+ directory:read/write_*)
# YANDEX_360_GRANT_EMAIL="stasinskipawel@yandex.ru"
# YANDEX_360_SHARED_FALLBACK_NICKNAME="info"
# Employee mailbox info@ (password from reset — do not commit real value)
# YANDEX_360_INFO_EMAIL="info@bober-systems.ru"
# YANDEX_360_INFO_PASSWORD=""

# Selectel — почтовый сервис (SMTP relay, не inbox)
# SELECTEL_IAM_TOKEN=""
# SELECTEL_SERVICE_USER=""
# SELECTEL_SERVICE_PASSWORD=""
# SELECTEL_ACCOUNT_ID=""
# SELECTEL_PROJECT_NAME=""
# SELECTEL_DOMAIN="tony-ai.ru"
# SELECTEL_MAIL_FROM="hello@tony-ai.ru"
# SELECTEL_DKIM_VALUE=""

# YANDEX_OAUTH_TOKEN=""
# YANDEX_METRIKA_OAUTH_TOKEN=""
# YANDEX_METRIKA_COUNTER_NAME="Bober AI Systems"
# Exclude own IP from counter (optional; "don't count my visits" is set via npm run metrika:filters)
# YANDEX_METRIKA_EXCLUDE_IP=""
# YANDEX_YTM_CONTAINER_ID=""  # ID контейнера YTM (если ≠ ID счётчика); npm run ytm:status
# npm run metrika:status  — снимок настроек счётчика и контентной аналитики
# npm run metrika:counter — создать/найти счётчик
# npm run ytm:status      — статус Тег Менеджера + галерея шаблонов (API только read)
# Demand radar (радар спроса): npm run demand-radar:report
# DEMAND_RADAR_MONTH="2026-07"  # optional; default = previous calendar month
# Manual CRM columns: data/demand-radar/manual/YYYY-MM.json (pipeline/deals — not in Metrica)
# YANDEX_WEBMASTER_CLIENT_ID="f2e2f11ae7e3492886ad61a6e45a4c5c"
# YANDEX_WEBMASTER_CLIENT_SECRET=""
# ClientID/secret ≠ access token. Один раз: npm run webmaster:oauth  (или yaga webmaster oauth)

# Яндекс Вебмастер — дополненное представление в поиске β (категория «Исполнители»)
# OAuth: https://yandex.ru/dev/webmaster/doc/ru/tasks/how-to-get-oauth
# YANDEX_WEBMASTER_OAUTH_TOKEN=""
# YANDEX_WEBMASTER_REFRESH_TOKEN=""
# YANDEX_WEBMASTER_HOST_URL="https://www.bober-systems.ru"
# YANDEX_WEBMASTER_SITEMAP_URL="https://www.bober-systems.ru/sitemap.xml"
# YANDEX_WEBMASTER_FEED_URL="https://www.bober-systems.ru/performers-feed.yml"
# YANDEX_WEBMASTER_FEED_TYPE="SERVICES"
# YANDEX_WEBMASTER_REGION_IDS="225"
# Микросайты (отдельные хосты + фиды): npm run webmaster:feed:upload -- --all
# YANDEX_WEBMASTER_BITRIX_HOST_URL="https://bitrix.bober-systems.ru"
# YANDEX_WEBMASTER_BITRIX_FEED_URL="https://bitrix.bober-systems.ru/performers-feed.yml"
# YANDEX_WEBMASTER_PARTNERS_HOST_URL="https://partners.bober-systems.ru"
# YANDEX_WEBMASTER_PARTNERS_FEED_URL="https://partners.bober-systems.ru/performers-feed.yml"

# Yandex Cloud Search API / Wordstat v2
# YANDEX_SEARCH_API_KEY=""
# YANDEX_SEARCH_FOLDER_ID=""
# YANDEX_FOLDER_ID=""
# YANDEX_CLOUD_ORGANIZATION_ID=""
# YANDEX_CLOUD_ORGANIZATION_NAME=""
# YANDEX_CLOUD_FOLDER_ID=""
# YANDEX_CLOUD_BILLING_ACCOUNT_ID=""
# YANDEX_CLOUD_BILLING_ACCOUNT_NAME=""

# Яндекс Аудитории (https://audience.yandex.com/)
# По умолчанию — OAuth-приложение «direct wordstat» (YANDEX_DIRECT_CLIENT_ID/SECRET).
# В приложении нужны scopes: audience:read audience:write (+ права Директа).
# Docs: https://yandex.ru/dev/audience/ru/intro/authorization
# npm run yandex:audience:oauth -- status
# npm run yandex:audience:oauth -- authorize-url
# npm run yandex:audience:oauth -- exchange --code <CODE>
# npm run yandex:audience -- sync-micro
# YANDEX_AUDIENCE_CLIENT_ID=""          # опционально; иначе YANDEX_DIRECT_CLIENT_ID
# YANDEX_AUDIENCE_CLIENT_SECRET=""
# YANDEX_AUDIENCE_REDIRECT_URI="https://oauth.yandex.ru/verification_code"
# YANDEX_AUDIENCE_OAUTH_TOKEN=""
# YANDEX_AUDIENCE_REFRESH_TOKEN=""
# YANDEX_AUDIENCE_TOKEN_EXPIRES_AT=""

# Yandex Direct API (OAuth app: direct wordstat)
# YANDEX_DIRECT_CLIENT_ID="7e70ff5be45f40119890ecefc09d2008"
# YANDEX_DIRECT_CLIENT_SECRET=""
# YANDEX_DIRECT_REDIRECT_URI="https://oauth.yandex.ru/verification_code"
# YANDEX_DIRECT_OAUTH_TOKEN=""
# YANDEX_DIRECT_REFRESH_TOKEN=""
# YANDEX_DIRECT_TOKEN_EXPIRES_AT=""
# npm run yandex:direct:campaigns -- status
# npm run yandex:direct:campaigns -- create-unified --dry-run
# «Мастер кампаний» через API недоступен — только ЕПК (UnifiedCampaign)

# Bitrix24 OAuth (локальное приложение → Sign B2E / REST / Sites)
# Входящий вебхук НЕ работает для sign.b2e — нужен client_id/secret приложения.
# Права (scopes): sign.b2e, crm, user, im, landing
# UI: Разработчикам → Локальные приложения → Изменить → ☑ Сайты (landing) → Сохранить → re-auth
#   npm run bitrix:oauth -- setup
#   npm run bitrix:oauth -- scopes          # список scopes + authorize URL
#   npm run bitrix:oauth -- set-app --client-id local.XXX --client-secret YYY
#   npm run bitrix:oauth -- authorize-url
#   npm run bitrix:oauth -- exchange --code <CODE>
#   npm run bitrix:oauth -- test --sign
#   npm run bitrix:oauth -- test --landing
#   npm run bitrix:site:teaser   # сайт-тизер PAGE → bober-ai.bitrix24site.ru (нужен landing)
#   npm run bitrix:catalog:sync  # товары в CRM catalog IBLOCK=24
#   npm run bitrix:shop:configure -- --hide-kwork  # STORE site/8 → bober shop (landing+crm)
# BITRIX24_PORTAL="https://b24-tuh0lz.bitrix24.ru"
# BITRIX24_CLIENT_ID=""
# BITRIX24_CLIENT_SECRET=""
# BITRIX24_REDIRECT_URI="https://www.bober-systems.ru/api/bitrix/oauth/callback"
# Install path в форме приложения: https://www.bober-systems.ru/api/bitrix/oauth/install
# BITRIX24_ACCESS_TOKEN=""
# BITRIX24_REFRESH_TOKEN=""
# BITRIX24_TOKEN_EXPIRES_AT=""
# BITRIX24_MEMBER_ID=""
# BITRIX24_CLIENT_ENDPOINT=""
# Создавать лиды в CRM из форм сайта (0 = выкл). Источник TELEGRAM или WEB.
# BITRIX24_LEADS_ENABLED="1"

# Kwork → Bitrix24 (официального API нет — session pull / CSV/JSON/HAR/capture/webhook)
# Профиль: https://kwork.ru/user/pasha_stasinski
# Cookies ТОЛЬКО локально (~/.config/yaga/credentials.env или KWORK_COOKIES_FILE), mode 0600, НЕ коммитить
#   npm run kwork:bitrix:pull -- --dry-run
#   npm run kwork:bitrix:pull
# Гайд offline-захвата: scripts/kwork-capture-guide.md (DevTools HAR предпочтительнее cat-catch)
#   npm run kwork:bitrix:sync -- --csv data/kwork-orders.example.csv --dry-run
#   npm run kwork:bitrix:from-har -- data/kwork-orders.har.example.json --dry-run
#   npm run kwork:bitrix:sync -- --capture data/kwork-capture.example.json --dry-run
#   npm run kwork:bitrix:sync -- --ensure-source-only
# Webhook stub: POST /api/kwork/webhook (X-Kwork-Webhook-Secret)
# KWORK_COOKIE=""
# KWORK_COOKIES_FILE="~/.config/yaga/kwork-cookies.txt"
# KWORK_PULL_STATUSES="all"
# KWORK_PROFILE_URL="https://kwork.ru/user/pasha_stasinski"
# KWORK_SOURCE_ID="KWORK"
# KWORK_ENTITY="lead"
# KWORK_WEBHOOK_SECRET=""
# KWORK_SYNC_STATE=""

# Kwork Bitrix (Python) — services/kwork-bitrix — Marketplace-oriented funnel aggregator
#   npm run kwork-bitrix:dry-run -- --json-file data/kwork-orders.example.json
#   npm run kwork-bitrix:ensure-funnel
#   npm run kwork-bitrix:sync -- --no-write
#   npm run kwork-bitrix:serve
# BITRIX_WEBHOOK_URL="https://<portal>/rest/<user>/<token>/"
# KWORK_BITRIX_SYNC_TOKEN="change-me"
# KWORK_BITRIX_FUNNEL_NAME="Kwork Bitrix"
# KWORK_BITRIX_ENTITY="deal"
# KWORK_BITRIX_SOURCE_ID="KWORKBITRIX"
# KWORK_BACKEND="auto"
# KWORK_LOGIN=""
# KWORK_PASSWORD=""
# KWORK_BITRIX_ALERT_TG_BOT_TOKEN=""
# KWORK_BITRIX_ALERT_TG_CHAT_ID=""
