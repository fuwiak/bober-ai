{
  "frozenAt": "2026-08-02",
  "reason": "Wordstat may detect demand only. No auto-publish to homepage, H1, offer, prices, or case facts. Proposals require human approval.",
  "rules": {
    "mayWrite": [
      "data/*.csv",
      "data/*-decisions.json",
      "data/*-seed-totals.json",
      "data/*.log",
      "data/wordstat-landing-route-report.json"
    ],
    "mustNotWrite": ["src/**", "public/**", "content/**"],
    "mustNotChange": ["homepage", "H1", "main offer", "prices", "case study facts"],
    "flow": [
      "detect growing phrase",
      "score purchase intent (npm run yandex:wordstat:route)",
      "assign existing landing OR propose new",
      "human approve",
      "monitor positions + qualified leads"
    ],
    "scoreGate": {
      "75-100": "commercial landing candidate — manual approve only",
      "60-74": "FAQ / fragment / article candidate",
      "40-59": "monitor, no publish",
      "0-39": "reject"
    }
  },
  "stableOfferUrls": [
    "/automation/ocr-data-extraction",
    "/integrations/bitrix24-implementation",
    "/automation/proposal-generation",
    "/automation/speech-analytics-sales",
    "/automation/meeting-to-crm"
  ],
  "fetch": "npm run yandex:wordstat requires WORDSTAT_ALLOW_FETCH=1 (or --allow-fetch). Deferred launchd disabled. Never auto-edit src/."
}
