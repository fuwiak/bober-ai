{
	email contact@bober-ai.dev
	# LE duplicate-cert rate limit until ~2026-07-30 for *.bober-ai.dev
	# (caddy_data wipe). Default ZeroSSL fallback is unusable from RU VDS:
	# ZeroSSL EAB API returns "Access Denied...restricted in your region"
	# (Caddy: invalid character 'A' looking for beginning of value).
	# Prefer SSL.com ACME (no EAB); keep LE as second issuer for after Jul 30.
	cert_issuer acme {
		dir https://acme.ssl.com/sslcom-dv-rsa
	}
	cert_issuer acme
	servers {
		protocols h1 h2
	}
}

(astro_proxy) {
	reverse_proxy 127.0.0.1:3001 {
		header_up Host {host}
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Real-IP {remote_host}
	}
}

(yml_headers) {
	# ">" replaces upstream text/yaml so clients see a single Content-Type.
	header >Content-Type "application/xml; charset=utf-8"
	header X-Content-Type-Options "nosniff"
}

:80 {
	handle /api/health {
		reverse_proxy 127.0.0.1:3001
	}
	@siteHost host www.bober-ai.dev bober-ai.dev partners.bober-ai.dev bitrix.bober-ai.dev www.bober-systems.ru bober-systems.ru partners.bober-systems.ru bitrix.bober-systems.ru
	handle @siteHost {
		header Cache-Control "no-store"
		redir https://{host}{uri} permanent
	}
	handle {
		respond "ok" 200
	}
}

https://bober-ai.dev {
	header Cache-Control "no-store"
	redir https://www.bober-ai.dev{uri} permanent
}

https://bober-systems.ru {
	header Cache-Control "no-store"
	redir https://www.bober-systems.ru{uri} permanent
}

https://www.bober-ai.dev {
	handle /performers-feed.yml {
		import yml_headers
		import astro_proxy
	}
	@yml path /feeds/*.yml
	handle @yml {
		import yml_headers
		import astro_proxy
	}
	import astro_proxy
}

https://www.bober-systems.ru {
	handle /performers-feed.yml {
		import yml_headers
		import astro_proxy
	}
	@yml path /feeds/*.yml
	handle @yml {
		import yml_headers
		import astro_proxy
	}
	import astro_proxy
}

https://partners.bober-ai.dev {
	# Pass through API, feeds, static assets (Next middleware parity)
	@passthrough path /api/* /feeds/* /performers-feed.yml /_astro/* /*.yml /*.xml /*.txt /*.md /*.ico /*.png /*.jpg /*.jpeg /*.webp /*.svg /*.js /*.css /favicon* /icon.png /apple-icon.png /manifest.webmanifest /robots.txt /sitemap.xml /stock/* /hero/* /diagrams/* /yandex/* /cases/* /portfolio/* /media/* /partners/* /tel/*
	handle @passthrough {
		handle /performers-feed.yml {
			rewrite * /feeds/partners.yml
			import yml_headers
			import astro_proxy
		}
		@yml path *.yml
		handle @yml {
			import yml_headers
		}
		import astro_proxy
	}
	handle {
		rewrite * /white-label
		import astro_proxy
	}
}

