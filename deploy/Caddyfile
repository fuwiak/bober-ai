{
	email contact@bober-ai.dev
	acme_ca https://acme-v02.api.letsencrypt.org/directory
	servers {
		protocols h1 h2
	}
}

(astro_proxy) {
	reverse_proxy 127.0.0.1:3000 {
		header_up Host {host}
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Real-IP {remote_host}
	}
}

:80 {
	handle /api/health {
		reverse_proxy 127.0.0.1:3000
	}
	@siteHost host www.bober-ai.dev bober-ai.dev partners.bober-ai.dev bitrix.bober-ai.dev www.bober-systems.ru bober-systems.ru partners.bober-systems.ru bitrix.bober-systems.ru
	handle @siteHost {
		header Cache-Control "no-store"
		redir https://{host}{uri} permanent
	}
	handle {
		respond "ok" 200
	}
}

https://bober-ai.dev {
	header Cache-Control "no-store"
	redir https://www.bober-ai.dev{uri} permanent
}

https://bober-systems.ru {
	header Cache-Control "no-store"
	redir https://www.bober-systems.ru{uri} permanent
}

https://www.bober-ai.dev {
	import astro_proxy
}

https://www.bober-systems.ru {
	import astro_proxy
}

https://partners.bober-ai.dev {
	rewrite * /white-label
	import astro_proxy
}

https://partners.bober-systems.ru {
	rewrite * /white-label
	import astro_proxy
}

https://bitrix.bober-ai.dev {
	rewrite * /bitrix
	import astro_proxy
}

https://bitrix.bober-systems.ru {
	rewrite * /bitrix
	import astro_proxy
}
