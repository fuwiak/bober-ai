{
	email contact@bober-systems.ru
	# Prefer LE (certs may already exist in caddy_data); SSL.com as fallback.
	# Keep hosts in SEPARATE site blocks for stable SNI.
	cert_issuer acme
	cert_issuer acme {
		dir https://acme.ssl.com/sslcom-dv-rsa
	}
	servers {
		protocols h1 h2
	}
}

(security_headers) {
	header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
	header X-Content-Type-Options "nosniff"
	header Referrer-Policy "strict-origin-when-cross-origin"
	header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
	header X-Frame-Options "SAMEORIGIN"
	header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; img-src 'self' data: https: blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://mc.yandex.ru https://yandex.ru; connect-src 'self' https://mc.yandex.ru https://mc.yandex.com https://yandex.ru wss://mc.yandex.ru; frame-src 'self' https://yandex.ru https://mc.yandex.ru; form-action 'self'"
}

(astro_proxy) {
	# App must listen on :3001 (compose PORT). Wrong PORT → 502 for all pages.
	reverse_proxy 127.0.0.1:3001 {
		header_up Host {host}
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Real-IP {remote_host}
		transport http {
			dial_timeout 3s
			response_header_timeout 30s
		}
	}
}

# Prerendered Astro HTML + hashed assets from /srv — survives Node restart/502.
# Only dynamic/API routes go to Node.
(static_first) {
	root * /srv
	encode zstd gzip

	import security_headers

	handle /api/health {
		reverse_proxy 127.0.0.1:3001
	}
	handle /health {
		rewrite * /api/health
		reverse_proxy 127.0.0.1:3001
	}

	@dynamic path /api/* /news /news/* /outages /outages/* /tel /tel/* /ru /ru/*
	handle @dynamic {
		import astro_proxy
	}

	# Hashed Astro assets: prefer /srv, but fall through to Node if a deploy
	# left HTML/CSS hashes out of sync (missing file → hard 404 kills CSS/menu).
	@immutable path /_astro/*
	handle @immutable {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server {
			pass_thru
		}
		import astro_proxy
	}

	@assets path /vendor/* /fonts/* *.js *.css *.woff2 *.woff *.ttf
	handle @assets {
		header Cache-Control "public, max-age=2592000, stale-while-revalidate=86400"
		file_server {
			pass_thru
		}
		import astro_proxy
	}

	@images path /stock/* /hero/* /partners/* /portfolio/* /media/* /cases/* /diagrams/* /yandex/* *.jpg *.jpeg *.webp *.png *.svg *.ico *.gif
	handle @images {
		header Cache-Control "public, max-age=2592000, stale-while-revalidate=86400"
		file_server {
			pass_thru
		}
		import astro_proxy
	}

	# Static HTML first; if missing (new SSR route), fall through to Node.
	handle {
		header Cache-Control "public, max-age=60, stale-while-revalidate=300"
		try_files {path} {path}/index.html {path}.html /index.html
		file_server {
			pass_thru
		}
		import astro_proxy
	}
}

(yml_headers) {
	# ">" replaces upstream text/yaml so clients see a single Content-Type.
	header >Content-Type "application/xml; charset=utf-8"
	header X-Content-Type-Options "nosniff"
	header Cache-Control "public, max-age=300"
}

# Static YML from dist/client mounted at /srv — survives Node/502 outages.
(yml_static) {
	root * /srv
	file_server
}

:80 {
	handle /api/health {
		reverse_proxy 127.0.0.1:3001
	}
	handle /health {
		rewrite * /api/health
		reverse_proxy 127.0.0.1:3001
	}
	# Apex systems: pages → https://www (one hop). robots → HTTPS apex
	# (same host) where Caddy serves 200 — Yandex "полная проверка"
	# fails if /robots.txt redirects to another hostname.
	@systemsApex host bober-systems.ru
	handle @systemsApex {
		header Cache-Control "no-store"
		@apexRobots path /robots.txt
		handle @apexRobots {
			redir https://bober-systems.ru{uri} permanent
		}
		handle {
			redir https://www.bober-systems.ru{uri} permanent
		}
	}
	@siteHost host www.bober-systems.ru partners.bober-systems.ru bitrix.bober-systems.ru
	handle @siteHost {
		header Cache-Control "no-store"
		redir https://{host}{uri} permanent
	}
	handle {
		respond "ok" 200
	}
}

https://bober-systems.ru {
	import security_headers
	# Serve robots (+ Yandex verify) on apex — do not redirect to www.
	@apexSeo path /robots.txt /yandex_*.html /sitemap*.xml
	handle @apexSeo {
		root * /srv
		try_files {path} {path}/index.html
		file_server {
			pass_thru
		}
		import astro_proxy
	}
	handle {
		header Cache-Control "no-store"
		redir https://www.bober-systems.ru{uri} permanent
	}
}

https://www.bober-systems.ru {
	# Live YML from Node (/api/feeds/performers) — always uses runtime SITE_URL.
	# Static /srv/performers-feed.yml kept in sync as cold backup (see CI copy).
	handle /performers-feed.yml {
		import yml_headers
		rewrite * /api/feeds/performers
		import astro_proxy
	}
	@yml path /feeds/*.yml
	handle @yml {
		import yml_headers
		import yml_static
	}
	import static_first
}

https://partners.bober-systems.ru {
	import security_headers
	handle /performers-feed.yml {
		import yml_headers
		rewrite * /api/feeds/partners
		import astro_proxy
	}
	@yml path /feeds/*.yml *.yml
	handle @yml {
		import yml_headers
		import yml_static
	}
	@passthrough path /api/* /_astro/* /vendor/* /fonts/* /*.xml /*.txt /*.md /*.ico /*.png /*.jpg /*.jpeg /*.webp /*.svg /*.js *.css /favicon* /icon.png /apple-icon.png /manifest.webmanifest /robots.txt /sitemap.xml /sitemap-*.xml /stock/* /hero/* /diagrams/* /yandex/* /cases/* /portfolio/* /media/* /partners/* /tel/*
	handle @passthrough {
		root * /srv
		try_files {path} {path}/index.html
		file_server {
			pass_thru
		}
		import astro_proxy
	}
	handle {
		rewrite * /white-label
		import astro_proxy
	}
}

