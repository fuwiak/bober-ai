{
	email contact@bober-ai.dev
	# Solo *.bober-ai.dev hits LE exact-set rate limit after caddy_data wipe.
	# Pair each .dev host with .ru twin → NEW identifier set (see site blocks below).
	# ZeroSSL EAB geo-blocked from RU. SSL.com ACME needs billing — leave disabled.
	cert_issuer acme
	servers {
		protocols h1 h2
	}
}

(astro_proxy) {
	# Compose sets PORT=3001 (deploy-web). If only legacy bober-web on :3000 is up,
	# point here to 3000 or start: docker compose up -d web
	reverse_proxy 127.0.0.1:3000 {
		header_up Host {host}
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Real-IP {remote_host}
	}
}

(yml_headers) {
	# ">" replaces upstream text/yaml so clients see a single Content-Type.
	header >Content-Type "application/xml; charset=utf-8"
	header X-Content-Type-Options "nosniff"
}

:80 {
	handle /api/health {
		reverse_proxy 127.0.0.1:3000
	}
	@siteHost host www.bober-ai.dev bober-ai.dev partners.bober-ai.dev bitrix.bober-ai.dev www.bober-systems.ru bober-systems.ru partners.bober-systems.ru bitrix.bober-systems.ru
	handle @siteHost {
		header Cache-Control "no-store"
		redir https://{host}{uri} permanent
	}
	handle {
		respond "ok" 200
	}
}

# Multi-SAN apex: new LE identifier set vs solo bober-ai.dev (rate-limited).
https://bober-ai.dev, bober-systems.ru {
	header Cache-Control "no-store"
	@ai host bober-ai.dev
	redir @ai https://www.bober-systems.ru{uri} permanent
	redir https://www.bober-systems.ru{uri} permanent
}

https://www.bober-ai.dev, www.bober-systems.ru {
	@legacyDev host www.bober-ai.dev
	redir @legacyDev https://www.bober-systems.ru{uri} permanent
	handle /performers-feed.yml {
		import yml_headers
		import astro_proxy
	}
	@yml path /feeds/*.yml
	handle @yml {
		import yml_headers
		import astro_proxy
	}
	import astro_proxy
}

https://partners.bober-ai.dev, partners.bober-systems.ru {
	# Pass through API, feeds, static assets (Next middleware parity)
	@passthrough path /api/* /feeds/* /performers-feed.yml /_astro/* /*.yml /*.xml /*.txt /*.md /*.ico /*.png /*.jpg /*.jpeg /*.webp /*.svg /*.js /*.css /favicon* /icon.png /apple-icon.png /manifest.webmanifest /robots.txt /sitemap.xml /stock/* /hero/* /diagrams/* /yandex/* /cases/* /portfolio/* /media/* /partners/* /tel/*
	handle @passthrough {
		handle /performers-feed.yml {
			rewrite * /feeds/partners.yml
			import yml_headers
			import astro_proxy
		}
		@yml path *.yml
		handle @yml {
			import yml_headers
		}
		import astro_proxy
	}
	handle {
		rewrite * /white-label
		import astro_proxy
	}
}

https://bitrix.bober-ai.dev, bitrix.bober-systems.ru {
	@passthrough path /api/* /feeds/* /performers-feed.yml /_astro/* /*.yml /*.xml /*.txt /*.md /*.ico /*.png /*.jpg /*.jpeg /*.webp /*.svg /*.js /*.css /favicon* /icon.png /apple-icon.png /manifest.webmanifest /robots.txt /sitemap.xml /stock/* /hero/* /diagrams/* /yandex/* /cases/* /portfolio/* /media/* /partners/* /tel/*
	handle @passthrough {
		handle /performers-feed.yml {
			rewrite * /feeds/bitrix.yml
			import yml_headers
			import astro_proxy
		}
		@yml path *.yml
		handle @yml {
			import yml_headers
		}
		import astro_proxy
	}
	handle {
		rewrite * /bitrix
		import astro_proxy
	}
}
