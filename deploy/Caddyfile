{
	email contact@bober-systems.ru
	# Prefer LE (certs may already exist in caddy_data); SSL.com as fallback.
	# Keep hosts in SEPARATE site blocks for stable SNI.
	cert_issuer acme
	cert_issuer acme {
		dir https://acme.ssl.com/sslcom-dv-rsa
	}
	servers {
		protocols h1 h2
	}
}

(astro_proxy) {
	# App must listen on :3001 (compose PORT). Wrong PORT → 502 for all pages.
	reverse_proxy 127.0.0.1:3001 {
		header_up Host {host}
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Real-IP {remote_host}
		transport http {
			dial_timeout 3s
			response_header_timeout 30s
		}
	}
}

(yml_headers) {
	# ">" replaces upstream text/yaml so clients see a single Content-Type.
	header >Content-Type "application/xml; charset=utf-8"
	header X-Content-Type-Options "nosniff"
	header Cache-Control "public, max-age=300"
}

# Static YML from dist/client mounted at /srv — survives Node/502 outages.
(yml_static) {
	root * /srv
	file_server
}

:80 {
	handle /api/health {
		reverse_proxy 127.0.0.1:3001
	}
	# Apex systems: pages → https://www (one hop). robots → HTTPS apex
	# (same host) where Caddy serves 200 — Yandex "полная проверка"
	# fails if /robots.txt redirects to another hostname.
	@systemsApex host bober-systems.ru
	handle @systemsApex {
		header Cache-Control "no-store"
		@apexRobots path /robots.txt
		handle @apexRobots {
			redir https://bober-systems.ru{uri} permanent
		}
		handle {
			redir https://www.bober-systems.ru{uri} permanent
		}
	}
	@siteHost host www.bober-systems.ru partners.bober-systems.ru bitrix.bober-systems.ru
	handle @siteHost {
		header Cache-Control "no-store"
		redir https://{host}{uri} permanent
	}
	handle {
		respond "ok" 200
	}
}

https://bober-systems.ru {
	# Serve robots (+ Yandex verify) on apex — do not redirect to www.
	@apexSeo path /robots.txt /yandex_*.html
	handle @apexSeo {
		import astro_proxy
	}
	handle {
		header Cache-Control "no-store"
		redir https://www.bober-systems.ru{uri} permanent
	}
}

https://www.bober-systems.ru {
	# Live YML from Node (/api/feeds/performers) — always uses runtime SITE_URL.
	# Static /srv/performers-feed.yml kept in sync as cold backup (see CI copy).
	handle /performers-feed.yml {
		import yml_headers
		rewrite * /api/feeds/performers
		import astro_proxy
	}
	@yml path /feeds/*.yml
	handle @yml {
		import yml_headers
		import yml_static
	}
	import astro_proxy
}

https://partners.bober-systems.ru {
	handle /performers-feed.yml {
		rewrite * /feeds/partners.yml
		import yml_headers
		import yml_static
	}
	@yml path /feeds/*.yml *.yml
	handle @yml {
		import yml_headers
		import yml_static
	}
	@passthrough path /api/* /_astro/* /*.xml /*.txt /*.md /*.ico /*.png /*.jpg /*.jpeg /*.webp /*.svg /*.js /*.css /favicon* /icon.png /apple-icon.png /manifest.webmanifest /robots.txt /sitemap.xml /stock/* /hero/* /diagrams/* /yandex/* /cases/* /portfolio/* /media/* /partners/* /tel/*
	handle @passthrough {
		import astro_proxy
	}
	handle {
		rewrite * /white-label
		import astro_proxy
	}
}

https://bitrix.bober-systems.ru {
	handle /performers-feed.yml {
		rewrite * /feeds/bitrix.yml
		import yml_headers
		import yml_static
	}
	@yml path /feeds/*.yml *.yml
	handle @yml {
		import yml_headers
		import yml_static
	}
	@passthrough path /api/* /_astro/* /*.xml /*.txt /*.md /*.ico /*.png /*.jpg /*.jpeg /*.webp /*.svg /*.js /*.css /favicon* /icon.png /apple-icon.png /manifest.webmanifest /robots.txt /sitemap.xml /stock/* /hero/* /diagrams/* /yandex/* /cases/* /portfolio/* /media/* /partners/* /tel/*
	handle @passthrough {
		import astro_proxy
	}
	handle {
		rewrite * /bitrix
		import astro_proxy
	}
}
