# Kwork Bitrix — copy to services/kwork-bitrix/.env (never commit secrets)

# API
HOST=0.0.0.0
PORT=8090
LOG_LEVEL=INFO
KWORK_BITRIX_SYNC_TOKEN="change-me"

# Bitrix24 incoming webhook (preferred)
# https://<portal>/rest/<user_id>/<secret>/
BITRIX_WEBHOOK_URL=""

# Or OAuth (same monorepo vars)
# BITRIX24_PORTAL="https://xxx.bitrix24.ru"
# BITRIX24_ACCESS_TOKEN=""
# BITRIX24_CLIENT_ENDPOINT=""

KWORK_BITRIX_FUNNEL_NAME="Kwork Bitrix"
# KWORK_BITRIX_CATEGORY_ID=
KWORK_BITRIX_ENTITY="deal"
KWORK_BITRIX_SOURCE_ID="KWORKBITRIX"

# Kwork — ONLY seller's own credentials; mode 0600; DO NOT commit
# KWORK_COOKIE="userId=...; csrf_user_token=...; ..."
# KWORK_COOKIES_FILE="~/.config/yaga/kwork-cookies.txt"
KWORK_PULL_STATUSES="all"
KWORK_PROFILE_URL="https://kwork.ru/user/pasha_stasinski"
KWORK_BACKEND="auto"
# Optional pykwork (unofficial mobile API — ToS risk)
# KWORK_LOGIN=""
# KWORK_PASSWORD=""

# Session-expired alerts (optional)
# KWORK_BITRIX_ALERT_TG_BOT_TOKEN=""
# KWORK_BITRIX_ALERT_TG_CHAT_ID=""
# KWORK_BITRIX_ALERT_EMAIL=""
