---
/**
 * Automation landings (UZ parked): SeoServicePage when content resolves.
 */
import SeoLanding from "@/components/SeoLanding.astro";
import SeoServicePage from "@/components/SeoServicePage.astro";
import { LANDING_PAGES } from "@/lib/landing-pages";
import type { Locale } from "@/lib/i18n";
import {
  getLandingKeywords,
  getLandingSeoServiceContent,
  landingHubLabel,
  landingOfferSlug,
} from "@/lib/landing-seo-service";

export const prerender = true;

export function getStaticPaths() {
  return LANDING_PAGES.filter((p) => p.category === "automation").map((page) => ({
    params: { slug: page.slug },
    props: { page, locale: "uz" as Locale },
  }));
}

const { page, locale } = Astro.props;
const content = getLandingSeoServiceContent(page, locale);
const path = `/automation/${page.slug}`;
const hubLabel = landingHubLabel("automation", locale);
const keywords = getLandingKeywords(page, locale);
---

{
  content ? (
    <SeoServicePage
      slug={page.slug}
      locale={locale}
      content={content}
      pagePath={path}
      serviceSlug={landingOfferSlug(page)}
      keywords={keywords}
      formSource={`automation-${page.slug}`}
      formDefaultService={content.h1}
      breadcrumbItems={[
        { name: hubLabel, path: "/automation" },
        { name: content.h1, path },
      ]}
    />
  ) : (
    <SeoLanding page={page} locale={locale} />
  )
}
