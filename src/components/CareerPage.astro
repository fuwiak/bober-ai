---
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { loadMessages, type Locale } from "@/lib/i18n";
import { absoluteUrl, CONTACT_EMAIL, SITE_NAME, TELEGRAM_URL } from "@/lib/site";

interface Props {
  locale: Locale;
}

type CareerRole = {
  id: string;
  title: string;
  department: string;
  type: string;
  summary: string;
  responsibilities: string[];
  requirements: string[];
  applySubject: string;
};

const { locale } = Astro.props;
const messages = loadMessages(locale);
const career = messages.career;
const isEn = locale === "en";
const roles = career.roles as CareerRole[];
const perks = career.perks as { title: string; description: string }[];
const canonicalPath = isEn ? "/en/career" : "/career";
const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: SITE_NAME, item: absoluteUrl(isEn ? "/en" : "/") },
    {
      "@type": "ListItem",
      position: 2,
      name: career.navLabel,
      item: absoluteUrl(canonicalPath),
    },
  ],
};
const jobPostings = roles.map((role) => ({
  "@context": "https://schema.org",
  "@type": "JobPosting",
  title: role.title,
  description: role.summary,
  datePosted: "2026-07-01",
  validThrough: "2026-12-31",
  hiringOrganization: {
    "@type": "Organization",
    name: SITE_NAME,
    sameAs: absoluteUrl("/"),
    logo: absoluteUrl("/favicon-120x120.png"),
  },
  employmentType: "CONTRACTOR",
  industry: "Artificial Intelligence",
  jobLocationType: "TELECOMMUTE",
  directApply: true,
  url: absoluteUrl(canonicalPath),
  applicationContact: {
    "@type": "ContactPoint",
    email: CONTACT_EMAIL,
    url: TELEGRAM_URL,
  },
}));
const jsonLd = [breadcrumbJsonLd, ...jobPostings];
---

<BaseLayout
  title={career.metaTitle}
  description={career.metaDescription}
  locale={locale}
  canonicalPath={canonicalPath}
  jsonLd={jsonLd}
>
  <section class="section-band section--deep border-b border-hairline">
    <div class="container-editorial">
      <Breadcrumbs locale={locale} items={[{ name: career.navLabel, path: "/career" }]} />
      <span class="section-label mt-8 inline-block">{career.label}</span>
      <h1 class="section-title mt-4 max-w-3xl">{career.title}</h1>
      <p class="body-copy mt-5 max-w-2xl text-base">{career.lead}</p>
    </div>
  </section>

  <section class="section-band section--panel border-b border-hairline">
    <div class="container-editorial">
      <div class="career-roles">
        {
          roles.map((role) => (
            <article class="career-role">
              <div class="career-role__meta">
                <span class="meta-label">{role.department}</span>
                <span class="career-role__type">{role.type}</span>
              </div>
              <h2 class="career-role__title">{role.title}</h2>
              <p class="body-copy mt-4 text-base">{role.summary}</p>
              <div class="career-role__columns mt-8">
                <div>
                  <p class="meta-label">{career.responsibilitiesLabel}</p>
                  <ul class="mt-3 space-y-2">
                    {role.responsibilities.map((item) => (
                      <li class="body-copy flex gap-3 text-sm">
                        <span class="meta-label shrink-0">—</span>
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                </div>
                <div>
                  <p class="meta-label">{career.requirementsLabel}</p>
                  <ul class="mt-3 space-y-2">
                    {role.requirements.map((item) => (
                      <li class="body-copy flex gap-3 text-sm">
                        <span class="meta-label shrink-0">—</span>
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
              <div class="mt-8 flex flex-wrap gap-3">
                <a
                  href={TELEGRAM_URL}
                  target="_blank"
                  rel="noreferrer"
                  class="btn-primary"
                  data-goal="career_telegram_click"
                >
                  {career.applyTelegram}
                </a>
                <a
                  href={`mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent(role.applySubject)}`}
                  class="btn-secondary"
                  data-goal="career_email_click"
                >
                  {career.applyEmail}
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section-band section--deep border-b border-hairline">
    <div class="container-editorial">
      <span class="section-label">{career.perksLabel}</span>
      <h2 class="section-title mt-4">{career.perksTitle}</h2>
      <div class="career-perks mt-10">
        {
          perks.map((perk) => (
            <div class="career-perk">
              <h3 class="card-title text-xl">{perk.title}</h3>
              <p class="body-copy mt-3 text-base">{perk.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
