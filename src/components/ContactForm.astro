---
import { localizePath, type Locale, type Messages } from "@/lib/i18n";
import { LEGAL_ROUTES } from "@/lib/legal";

export type ContactFormIntent = "estimate" | "order";

interface Props {
  locale: Locale;
  messages: Messages;
  /** estimate = «Получить оценку»; order = «Оформить заказ». Default estimate. */
  intent?: ContactFormIntent;
  qualify?: boolean;
  /** Lead-qualifying variant: company / site / role / team size, fields open by default. */
  qualifyOpen?: boolean;
  extended?: boolean;
  source?: string;
  defaultService?: string;
  abTestLength?: boolean;
  trackingPrefix?: string;
}

const {
  locale,
  messages,
  intent = "estimate",
  qualify = false,
  qualifyOpen = false,
  extended = false,
  source = "site-form",
  defaultService = "",
  abTestLength = true,
  trackingPrefix = "",
} = Astro.props;
const form = messages.form;
const showQualify = qualify || qualifyOpen;
const isOrder = intent === "order";
const intro = isOrder ? form.orderIntro : form.intro;
const introShort = isOrder ? form.orderIntroShort : form.introShort;
const messageLabel = isOrder ? form.orderMessage : form.message;
const messagePlaceholder = isOrder ? form.orderMessagePlaceholder : form.messagePlaceholder;
const submitLabel = isOrder ? form.orderSubmit : form.submit;
const resolvedSource = source || (isOrder ? "order-form" : "site-form");
const privacyHref = localizePath(LEGAL_ROUTES.privacyPolicy, locale);
const consentHref = localizePath(LEGAL_ROUTES.consent, locale);
const uid = `cf-${Math.random().toString(36).slice(2, 8)}`;
---

<form
  class:list={["contact-form", "space-y-6", isOrder ? "contact-form--order" : "contact-form--estimate"]}
  action="/api/contact"
  method="post"
  hx-post="/api/contact"
  hx-swap="outerHTML"
  data-contact-form
  data-form-intent={intent}
  data-ab-length={abTestLength ? "true" : undefined}
  data-tracking-prefix={trackingPrefix || undefined}
  data-intro-short={introShort}
>
  <p class="body-copy text-sm text-muted" data-contact-intro>{intro}</p>

  <input
    type="text"
    name="website"
    tabindex="-1"
    autocomplete="off"
    aria-hidden="true"
    class="absolute -left-[9999px] h-0 w-0 opacity-0"
  />
  <input type="hidden" name="locale" value={locale} />
  <input type="hidden" name="source" value={resolvedSource} />
  <input type="hidden" name="intent" value={intent} />
  <input type="hidden" name="service" value={defaultService} data-contact-default-service />
  <input type="hidden" name="utm_source" value="" />
  <input type="hidden" name="utm_medium" value="" />
  <input type="hidden" name="utm_campaign" value="" />
  <input type="hidden" name="utm_content" value="" />
  <input type="hidden" name="utm_term" value="" />
  <input type="hidden" name="yclid" value="" />
  <input type="hidden" name="landing_page" value="" />

  <div>
    <label for={`${uid}-name`} class="form-label">{form.name}</label>
    <input id={`${uid}-name`} name="name" required autocomplete="name" class="text-input" />
  </div>

  {
    qualifyOpen && (
      <div class="contact-qualify__grid">
        <div>
          <label for={`${uid}-company`} class="form-label">{form.company}</label>
          <input
            id={`${uid}-company`}
            name="company"
            required
            autocomplete="organization"
            class="text-input"
          />
        </div>
        <div>
          <label for={`${uid}-company-site`} class="form-label">
            {form.companySite}
            <span class="text-muted-soft">{form.optional}</span>
          </label>
          <input
            id={`${uid}-company-site`}
            name="companySite"
            type="text"
            inputmode="url"
            autocomplete="url"
            class="text-input"
            placeholder="company.ru"
          />
        </div>
      </div>
    )
  }

  {
    extended && !qualifyOpen && (
      <div data-contact-extended>
        <div>
          <label for={`${uid}-company`} class="form-label">
            {form.company}
            <span class="text-muted-soft">{form.optional}</span>
          </label>
          <input id={`${uid}-company`} name="company" autocomplete="organization" class="text-input" />
        </div>
      </div>
    )
  }

  <div>
    <label for={`${uid}-contact`} class="form-label">{form.contact}</label>
    <input
      id={`${uid}-contact`}
      name="contact"
      required
      autocomplete="email tel"
      class="text-input"
      placeholder={form.contactPlaceholder}
    />
  </div>

  {
    qualifyOpen && (
      <div>
        <label for={`${uid}-role`} class="form-label">{form.role}</label>
        <input id={`${uid}-role`} name="role" class="text-input" autocomplete="organization-title" />
      </div>
    )
  }

  <div>
    <label for={`${uid}-message`} class="form-label">
      {messageLabel}
      <span class="text-muted-soft">{form.optional}</span>
    </label>
    <textarea
      id={`${uid}-message`}
      name="message"
      rows={3}
      class="textarea-input"
      placeholder={messagePlaceholder}
    />
  </div>

  {
    showQualify && (
      <details
        class="contact-qualify border-t border-hairline pt-6"
        data-contact-qualify
        open={qualifyOpen || undefined}
      >
        <summary class="form-label cursor-pointer select-none">{form.qualifyLegend}</summary>
        <p class="mt-2 text-sm text-muted">{form.qualifyHint}</p>
        <div class="mt-4 space-y-4">
          <div>
            <label for={`${uid}-process`} class="form-label">{form.processType}</label>
            <select id={`${uid}-process`} name="processType" class="text-input">
              <option value="">{form.selectPlaceholder}</option>
              {form.processOptions.map((opt) => (
                <option value={opt}>{opt}</option>
              ))}
            </select>
          </div>
          <div>
            <label for={`${uid}-systems`} class="form-label">{form.systems}</label>
            <select id={`${uid}-systems`} name="systems" class="text-input">
              <option value="">{form.selectPlaceholder}</option>
              {form.systemsOptions.map((opt) => (
                <option value={opt}>{opt}</option>
              ))}
            </select>
          </div>
          {qualifyOpen && (
            <div>
              <label for={`${uid}-team-size`} class="form-label">{form.teamSize}</label>
              <select id={`${uid}-team-size`} name="teamSize" class="text-input">
                <option value="">{form.selectPlaceholder}</option>
                {form.teamSizeOptions.map((opt) => (
                  <option value={opt}>{opt}</option>
                ))}
              </select>
            </div>
          )}
          <div>
            <label for={`${uid}-budget`} class="form-label">{form.budget}</label>
            <select id={`${uid}-budget`} name="budget" class="text-input">
              <option value="">{form.selectPlaceholder}</option>
              {form.budgetOptions.map((opt) => (
                <option value={opt}>{opt}</option>
              ))}
            </select>
          </div>
          <div>
            <label for={`${uid}-timeline`} class="form-label">{form.timeline}</label>
            <select id={`${uid}-timeline`} name="timeline" class="text-input">
              <option value="">{form.selectPlaceholder}</option>
              {form.timelineOptions.map((opt) => (
                <option value={opt}>{opt}</option>
              ))}
            </select>
          </div>
        </div>
      </details>
    )
  }

  <div class="border-t border-hairline pt-6">
    <label for={`${uid}-pd-consent`} class="flex cursor-pointer items-start gap-3">
      <input
        id={`${uid}-pd-consent`}
        name="policyAccepted"
        type="checkbox"
        value="true"
        required
        class="mt-1 h-4 w-4 shrink-0 border-hairline-strong accent-ink"
      />
      <span class="text-sm leading-relaxed text-muted">
        {form.consentCombined}
        <a href={privacyHref} class="text-link" target="_blank" rel="noopener noreferrer">
          {form.policyLink}
        </a>
        {form.consentAnd}
        <a href={consentHref} class="text-link" target="_blank" rel="noopener noreferrer">
          {form.consentLink}
        </a>
        .
      </span>
    </label>
    <input type="hidden" name="consent" value="true" />
  </div>

  <button type="submit" class="contact-submit btn-primary w-full">
    <span class="contact-submit__label">{submitLabel}</span>
  </button>
</form>
