---
import ContactForm from "@/components/ContactForm.astro";
import type { Locale, Messages } from "@/lib/i18n";
import { CONTACT_EMAIL, MAX_URL, TELEGRAM_URL, WHATSAPP_URL } from "@/lib/site";

interface Props {
  locale: Locale;
  messages: Messages;
}

const { locale, messages } = Astro.props;
const c = messages.contact;
---

<div
  class="contact-modal"
  data-contact-modal
  data-intent-service={c.intentDefaultService}
  hidden
  role="dialog"
  aria-modal="true"
  aria-labelledby="contact-modal-title"
>
  <button type="button" class="contact-modal__backdrop" aria-label={c.modalClose} data-contact-close />
  <div class="contact-modal__panel">
    <div class="contact-modal__header">
      <div>
        <h2 id="contact-modal-title" class="card-title text-2xl" data-contact-default-only>
          {c.title}
        </h2>
        <h2 class="card-title text-2xl" data-contact-soft-only hidden>{c.intentTitle}</h2>
        <p class="body-copy mt-3 text-base" data-contact-default-only>{c.subtitle}</p>
        <p class="body-copy mt-3 text-base" data-contact-soft-only hidden>{c.intentSubtitle}</p>
        <p class="contact-modal__offer meta-label mt-4" data-contact-soft-only hidden>{c.intentOffer}</p>
      </div>
      <button type="button" class="contact-modal__close" data-contact-close aria-label={c.modalClose}>
        ×
      </button>
    </div>
    <div class="contact-modal__channels">
      <p class="meta-label">{c.modalChannels}</p>
      <div class="contact-modal__channel-grid">
        <a
          href={TELEGRAM_URL}
          target="_blank"
          rel="noreferrer"
          class="contact-modal__channel btn-secondary"
          data-goal="modal_telegram_click">{c.telegram}</a
        >
        <a
          href={WHATSAPP_URL}
          target="_blank"
          rel="noreferrer"
          class="contact-modal__channel btn-secondary"
          data-goal="modal_whatsapp_click">{c.whatsapp}</a
        >
        {
          MAX_URL ? (
            <a
              href={MAX_URL}
              target="_blank"
              rel="noreferrer"
              class="contact-modal__channel btn-secondary"
              data-goal="max_click">MAX</a
            >
          ) : null
        }
        <a
          href={`mailto:${CONTACT_EMAIL}`}
          class="contact-modal__channel btn-secondary"
          data-goal="modal_email_click">{c.email}</a
        >
      </div>
    </div>
    <div class="contact-modal__divider" aria-hidden="true">
      <span>{c.modalFormDivider}</span>
    </div>
    <ContactForm
      locale={locale}
      messages={messages}
      intent="estimate"
      qualify
      extended
      source="contact-modal"
    />
  </div>
</div>
