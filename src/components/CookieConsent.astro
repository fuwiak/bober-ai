---
import { localizePath, type Locale, type Messages } from "@/lib/i18n";
import { absoluteUrl } from "@/lib/site";
import { COOKIE_CONSENT_KEY, LEGAL_ROUTES } from "@/lib/legal";

interface Props {
  locale: Locale;
  messages: Messages;
}

const { locale } = Astro.props;
const copy =
  locale === "uz"
    ? {
        title: "Cookie va analitika",
        descBefore: "Sayt cookie va\u00a0Yandex.Metrica dan tashrif analitikasida foydalanadi. Batafsil —\u00a0",
        policy: "Maxfiylik siyosati",
        descAfter: ". Saytdan foydalanishni davom ettirib, siyosat bilan tanishganingizni tasdiqlaysiz.",
        reject: "Faqat zaruriy",
        accept: "Qabul qilish",
      }
    : {
        title: "Cookies и аналитика",
        descBefore: "Этот сайт использует Cookies и\u00a0Яндекс.Метрику для аналитики посещений. Подробности — в\u00a0",
        policy: "Политике конфиденциальности",
        descAfter:
          ". Продолжая пользоваться сайтом, вы\u00a0подтверждаете ознакомление с\u00a0политикой.",
        reject: "Только необходимые",
        accept: "Принять",
      };
const privacyUrl = absoluteUrl(localizePath(LEGAL_ROUTES.privacyPolicy, locale));
void COOKIE_CONSENT_KEY;
---

<div
  data-cookie-consent
  hidden
  role="dialog"
  aria-labelledby="cookie-consent-title"
  aria-describedby="cookie-consent-desc"
  class="cookie-consent"
>
  <div class="cookie-consent-card">
    <p id="cookie-consent-title" class="cookie-consent-title">{copy.title}</p>
    <p id="cookie-consent-desc" class="cookie-consent-desc">
      {copy.descBefore}
      <a href={privacyUrl} class="text-link">{copy.policy}</a>
      {copy.descAfter}
    </p>
    <div class="cookie-consent-actions">
      <button type="button" data-cookie-reject class="btn-secondary text-xs">{copy.reject}</button>
      <button type="button" data-cookie-accept class="btn-primary text-xs">{copy.accept}</button>
    </div>
  </div>
</div>
