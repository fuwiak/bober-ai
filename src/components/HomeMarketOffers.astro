---
import { localizePath, type Locale } from "@/lib/i18n";
import { HIGH_DEMAND_PARTNER_OFFERS } from "@/lib/market-offers";

interface Props {
  locale: Locale;
  label: string;
  title: string;
  subtitle: string;
  ctaLabel: string;
  pillars?: string[];
  hubHref?: string;
  hubCta?: string;
}

const { locale, label, title, subtitle, ctaLabel, pillars = [], hubHref, hubCta } = Astro.props;
---

<section id="market-offers" class="section-band section--panel scroll-mt-16 border-b border-hairline">
  <div class="container-editorial">
    <span class="section-label">{label}</span>
    <h2 class="section-title mt-4">{title}</h2>
    {subtitle ? <p class="body-copy mt-4 max-w-2xl text-base">{subtitle}</p> : null}
    {
      pillars.length ? (
        <ul class="market-offer-pillars mt-6">
          {pillars.map((pillar) => (
            <li>{pillar}</li>
          ))}
        </ul>
      ) : null
    }

    <div class="market-offers-grid mt-10">
      {
        HIGH_DEMAND_PARTNER_OFFERS.map((offer) => (
          <a
            href={localizePath(offer.href, locale)}
            class="market-offer-card"
            data-goal="market_offer_click"
            data-offer={offer.id}
          >
            <p class="meta-label">{offer.priceLabel}</p>
            <h3 class="card-title mt-3 text-xl">{offer.title}</h3>
            <p class="body-copy mt-3 text-base">{offer.description}</p>
            <span class="link-more mt-6">{ctaLabel}</span>
          </a>
        ))
      }
    </div>
    {
      hubHref && hubCta ? (
        <p class="mt-8">
          <a class="link-more" href={localizePath(hubHref, locale)}>
            {hubCta}
          </a>
        </p>
      ) : null
    }
  </div>
</section>
