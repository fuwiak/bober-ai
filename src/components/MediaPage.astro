---
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { loadMessages, localizePath, type Locale } from "@/lib/i18n";
import {
  YANDEX_PROOF_URL,
  credibilityGraphJsonLd,
  getCredibilityItems,
  getMediaDossierSections,
} from "@/lib/media";
import { absoluteUrl } from "@/lib/site";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const messages = loadMessages(locale);
const media = messages.media;
const page = messages.pages.media;
const canonicalPath = localizePath("/media", locale);
const pageUrl = absoluteUrl(canonicalPath);
const items = getCredibilityItems(locale);
const byId = new Map(items.map((item) => [item.id, item]));
const sections = getMediaDossierSections(locale);
const graph = credibilityGraphJsonLd(pageUrl, locale);
const proofItems = media.proofItems as string[];
---

<BaseLayout
  title={page.metaTitle}
  description={page.metaDescription}
  locale={locale}
  canonicalPath={canonicalPath}
  jsonLd={graph}
>
  <section class="section-band section--deep border-b border-hairline">
    <div class="container-editorial max-w-3xl">
      <Breadcrumbs
        locale={locale}
        items={[{ name: locale === "uz" ? "OAV" : "СМИ", path: "/media" }]}
      />
    </div>
  </section>

  <section id="media" class="credibility-section section-band section--deep scroll-mt-16 border-t border-hairline">
    <div class="container-editorial">
      <span class="section-label">{media.label}</span>
      <h1 class="section-title mt-4 max-w-4xl">{media.title}</h1>
      <p class="body-copy mt-4 max-w-3xl text-base text-muted">{media.subtitle}</p>
      <p class="body-copy mt-4 max-w-3xl text-base">{media.body}</p>
      <ul class="mt-8 max-w-3xl space-y-3">
        {
          proofItems.map((item) => (
            <li class="body-copy flex gap-3 text-base">
              <span class="meta-label shrink-0">—</span>
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
      <p class="body-copy mt-8 max-w-3xl text-base text-muted">{media.closing}</p>
    </div>
  </section>

  {
    sections.map((section) => (
      <section id={section.id} class="section-band border-b border-hairline">
        <div class="container-editorial">
          <h2 class="card-title text-xl">{section.title}</h2>
          {section.id === "proof" ? (
            <div class="mt-8 max-w-2xl space-y-4">
              <p class="body-copy text-base">
                {locale === "uz"
                  ? "Mijozlar fikri va Yandex Xizmatlardagi profil doimiy tijorat yetkazib berishni tasdiqlaydi — anonim pudrat emas."
                  : "Отзывы клиентов и профиль на Яндекс Услугах подтверждают коммерческую практику — не анонимный подряд."}
              </p>
              <a
                href={YANDEX_PROOF_URL}
                target="_blank"
                rel="noopener noreferrer"
                class="text-link inline-flex items-center gap-2 text-sm"
              >
                {locale === "uz" ? "Yandex Xizmatlar profilini ochish" : "Открыть профиль на Яндекс Услугах"}
                <span aria-hidden="true">→</span>
              </a>
            </div>
          ) : (
            <ul class="mt-8 space-y-8">
              {section.itemIds.map((id) => {
                const item = byId.get(id);
                if (!item) return null;
                return (
                  <li class="border-t border-hairline pt-6">
                    <p class="meta-label">
                      {item.source} · {item.type}
                    </p>
                    <h3 class="card-title mt-2 text-lg">{item.title}</h3>
                    <p class="body-copy mt-3 max-w-3xl text-base">{item.description}</p>
                    <p class="mt-3 text-sm text-muted">{item.meta}</p>
                    <a
                      href={item.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-link mt-4 inline-flex items-center gap-2 text-sm"
                    >
                      {item.cta}
                      <span aria-hidden="true">→</span>
                    </a>
                    {item.secondaryLinks?.length ? (
                      <div class="mt-3 flex flex-wrap gap-4">
                        {item.secondaryLinks.map((link) => (
                          <a
                            href={link.url}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="text-link text-xs"
                          >
                            {link.label}
                          </a>
                        ))}
                      </div>
                    ) : null}
                  </li>
                );
              })}
            </ul>
          )}
        </div>
      </section>
    ))
  }
</BaseLayout>
