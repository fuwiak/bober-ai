---
/**
 * Static ChatGPT-like chat mock for ERP МойСклад landing.
 * UX cues from conversational CRM (message list, composer, chips) —
 * styled with Bober editorial tokens (not purple/cream reference skins).
 */
import { MOYSKLAD_CHAT_DEMO } from "@/lib/moysklad-landing";

interface Props {
  label?: string;
  title?: string;
  subtitle?: string;
}

const { label = "Демо UX", title = "Работа с МойСклад как в ChatGPT", subtitle } = Astro.props;
const demo = MOYSKLAD_CHAT_DEMO;
const lead = subtitle ?? demo.subtitle;
---

<section class="section-band section--panel border-b border-hairline" id="chatgpt-ux">
  <div class="container-editorial">
    <span class="section-label">{label}</span>
    <h2 class="section-title mt-4 max-w-2xl">{title}</h2>
    <p class="body-copy mt-4 max-w-2xl text-base">{lead}</p>

    <div class="ms-chat mt-10" role="region" aria-label={demo.title}>
      <header class="ms-chat__head">
        <div>
          <p class="ms-chat__name">{demo.title}</p>
          <p class="ms-chat__hint">{demo.status}</p>
        </div>
        <span class="ms-chat__live" aria-hidden="true">● online</span>
      </header>

      <ul class="ms-chat__list">
        {
          demo.messages.map((msg) => (
            <li class:list={["ms-chat__row", msg.role === "user" && "ms-chat__row--user"]}>
              <span class="ms-chat__role">{msg.role === "user" ? "Вы" : "Ассистент"}</span>
              <div class:list={["ms-chat__bubble", msg.role === "user" ? "ms-chat__bubble--user" : "ms-chat__bubble--bot"]}>
                {msg.text}
              </div>
            </li>
          ))
        }
      </ul>

      <div class="ms-chat__chips" aria-label="Примеры запросов">
        {
          demo.suggestions.map((chip) => (
            <span class="ms-chat__chip">{chip}</span>
          ))
        }
      </div>

      <div class="ms-chat__composer" aria-hidden="true">
        <span class="ms-chat__input">{demo.composerPlaceholder}</span>
        <span class="ms-chat__send">Отправить</span>
      </div>
    </div>
  </div>
</section>

<style>
  .ms-chat {
    max-width: 40rem;
    border: 1px solid var(--color-hairline, #d8d9de);
    background: var(--color-surface-card, #fff);
    overflow: hidden;
  }

  .ms-chat__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--color-hairline, #d8d9de);
    background: var(--color-surface-soft, #f3f4f6);
  }

  .ms-chat__name {
    margin: 0;
    font-family: var(--font-display, inherit);
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-ink, #1a1c22);
  }

  .ms-chat__hint {
    margin: 0.25rem 0 0;
    font-size: 0.8125rem;
    color: var(--color-muted, #6b7280);
  }

  .ms-chat__live {
    flex-shrink: 0;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--color-primary, #3a450c);
  }

  .ms-chat__list {
    list-style: none;
    margin: 0;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-height: 28rem;
    overflow-y: auto;
  }

  .ms-chat__row {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.35rem;
    max-width: 92%;
  }

  .ms-chat__row--user {
    align-self: flex-end;
    align-items: flex-end;
  }

  .ms-chat__role {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-muted, #6b7280);
  }

  .ms-chat__bubble {
    padding: 0.75rem 1rem;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--color-ink, #1a1c22);
    border: 1px solid var(--color-hairline, #d8d9de);
  }

  .ms-chat__bubble--bot {
    background: var(--color-surface-soft, #f3f4f6);
    border-radius: 0.25rem 0.75rem 0.75rem 0.75rem;
  }

  .ms-chat__bubble--user {
    background: color-mix(in srgb, var(--color-primary, #3a450c) 12%, transparent);
    border-color: color-mix(in srgb, var(--color-primary, #3a450c) 28%, var(--color-hairline, #d8d9de));
    border-radius: 0.75rem 0.25rem 0.75rem 0.75rem;
  }

  .ms-chat__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0 1.25rem 1rem;
  }

  .ms-chat__chip {
    font-size: 0.75rem;
    line-height: 1.3;
    padding: 0.4rem 0.7rem;
    border: 1px solid var(--color-hairline, #d8d9de);
    color: var(--color-ink, #1a1c22);
    background: transparent;
  }

  .ms-chat__composer {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.85rem 1.25rem;
    border-top: 1px solid var(--color-hairline, #d8d9de);
  }

  .ms-chat__input {
    flex: 1;
    font-size: 0.875rem;
    color: var(--color-muted, #6b7280);
    padding: 0.55rem 0.75rem;
    border: 1px solid var(--color-hairline, #d8d9de);
    background: var(--color-canvas, #fff);
  }

  .ms-chat__send {
    flex-shrink: 0;
    font-size: 0.8125rem;
    font-weight: 600;
    padding: 0.55rem 0.9rem;
    background: var(--color-primary, #3a450c);
    color: var(--color-on-primary, #fff);
  }
</style>
