---
/**
 * ChatGPT-like UX preview for ERP МойСклад — real product UI screenshot.
 */
import { PORTFOLIO_IMAGES } from "@/lib/site";

interface Props {
  label?: string;
  title?: string;
  subtitle?: string;
}

const {
  label = "Демо UX",
  title = "Работа с МойСклад как в ChatGPT",
  subtitle = "Склад и учёт МойСклад + чат к остаткам, заказам и CRM — вопрос на естественном языке, ответ с цифрами и действиями.",
} = Astro.props;
---

<section class="section-band section--panel border-b border-hairline" id="chatgpt-ux">
  <div class="container-editorial">
    <span class="section-label">{label}</span>
    <h2 class="section-title mt-4 max-w-2xl">{title}</h2>
    <p class="body-copy mt-4 max-w-2xl text-base">{subtitle}</p>

    <figure class="ms-ux mt-10">
      <img
        src={PORTFOLIO_IMAGES.erpMoysklad}
        alt="ИИ-ассистент в ERP/CRM: чат к остаткам, заказам, аналитике и источникам данных"
        width="1024"
        height="695"
        loading="lazy"
        decoding="async"
        class="ms-ux__img"
      />
      <figcaption class="mt-3 text-sm text-muted">
        ChatGPT-like UX: вопрос по продажам и складу → ответ с цифрами, графиком и рекомендацией
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .ms-ux {
    margin: 0;
    max-width: 56rem;
  }

  .ms-ux__img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--color-hairline, #d8d9de);
    background: var(--color-surface-card, #fff);
  }
</style>
