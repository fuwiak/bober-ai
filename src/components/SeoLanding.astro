---
import ContactForm from "@/components/ContactForm.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { loadMessages, localizePath, type Locale } from "@/lib/i18n";
import {
  getCatalogLandingContent,
  getCatalogLandingExtended,
  isCatalogContentKey,
} from "@/lib/seo-catalog";
import type { LandingPageDef } from "@/lib/landing-pages";
import { getLandingExtended } from "@/lib/landing-extended";
import {
  getEnterpriseService,
  getEnterpriseServiceByFeedPath,
} from "@/lib/enterprise-services";

interface Props {
  page: LandingPageDef;
  locale: Locale;
}

const { page, locale } = Astro.props;
const messages = loadMessages(locale);
const loc = locale;
const fromCatalog = page.fromCatalog || isCatalogContentKey(page.contentKey);

type LandingContent = {
  metaTitle: string;
  metaDescription: string;
  eyebrow: string;
  h1: string;
  subtitle: string;
  problemsTitle: string;
  problems: string[];
  deliverablesTitle: string;
  deliverables: string[];
  relatedTitle: string;
  related: { href: string; label: string }[];
  faq?: { q: string; a: string }[];
};

let content: LandingContent;
let extended = getLandingExtended(page.contentKey, loc);

if (fromCatalog) {
  const catalogContent = getCatalogLandingContent(page.contentKey, loc);
  if (!catalogContent) throw new Error(`Missing catalog content for ${page.contentKey}`);
  content = catalogContent;
  extended = getCatalogLandingExtended(page.contentKey, loc) ?? extended;
} else {
  const pages = (messages as { landing?: { pages?: Record<string, LandingContent> } }).landing
    ?.pages;
  content = pages?.[page.contentKey] as LandingContent;
  if (!content) throw new Error(`Missing landing content ${page.contentKey}`);
}

const catalogService = getEnterpriseService(page.serviceSlug, locale);
const feedOffer = getEnterpriseServiceByFeedPath(`/${page.category}/${page.slug}`, locale);
const commercial = feedOffer ?? catalogService;
const faqItems = extended?.faq ?? content.faq ?? [];
const canonicalPath = localizePath(`/${page.category}/${page.slug}`, locale);
---

<BaseLayout
  title={content.metaTitle}
  description={content.metaDescription}
  locale={locale}
  canonicalPath={canonicalPath}
>
  <article class="container-editorial py-12 md:py-20">
    <p class="meta-label">{content.eyebrow}</p>
    <h1 class="mt-4 display-title">{content.h1}</h1>
    <p class="mt-6 body-copy max-w-3xl">{content.subtitle}</p>

    {
      commercial && (
        <p class="mt-4 text-sm text-muted">
          {commercial.salesNotes}
          {locale === "en" ? " · from " : " · от "}
          {commercial.price.toLocaleString(locale === "en" ? "en-US" : "ru-RU")}
          {locale === "en" ? " ₽" : " ₽"}
        </p>
      )
    }

    <section class="mt-14">
      <h2 class="section-title">{content.problemsTitle}</h2>
      <ul class="mt-6 space-y-3">
        {content.problems.map((item) => (
          <li class="body-copy flex gap-3">
            <span class="text-accent" aria-hidden>
              —
            </span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </section>

    <section class="mt-14">
      <h2 class="section-title">{content.deliverablesTitle}</h2>
      <ul class="mt-6 space-y-3">
        {content.deliverables.map((item) => (
          <li class="body-copy flex gap-3">
            <span class="text-accent" aria-hidden>
              —
            </span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </section>

    {
      faqItems.length > 0 && (
        <section class="mt-14">
          <h2 class="section-title">{locale === "en" ? "FAQ" : "Частые вопросы"}</h2>
          <div class="mt-6 space-y-6">
            {faqItems.map((item) => (
              <div>
                <h3 class="font-medium text-ink">{item.q}</h3>
                <p class="mt-2 body-copy text-muted">{item.a}</p>
              </div>
            ))}
          </div>
        </section>
      )
    }

    {
      content.related?.length > 0 && (
        <section class="mt-14">
          <h2 class="section-title">{content.relatedTitle}</h2>
          <nav class="mt-6 flex flex-wrap gap-4">
            {content.related.map((item) => (
              <a class="text-link" href={localizePath(item.href, locale)}>
                {item.label}
              </a>
            ))}
          </nav>
        </section>
      )
    }

    <section id="contact" class="mt-16 border-t border-hairline pt-12">
      <h2 class="section-title">{messages.nav.contact}</h2>
      <div class="mt-8 max-w-xl">
        <ContactForm locale={locale} messages={messages} />
      </div>
    </section>
  </article>
</BaseLayout>
