---
import ContactForm from "@/components/ContactForm.astro";
import ServiceAudienceBand from "@/components/ServiceAudienceBand.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { loadMessages, localizePath, type Locale } from "@/lib/i18n";
import {
  getCatalogLandingContent,
  getCatalogLandingExtended,
  isCatalogContentKey,
} from "@/lib/seo-catalog";
import type { LandingPageDef } from "@/lib/landing-pages";
import { getLandingExtended } from "@/lib/landing-extended";
import {
  getEnterpriseService,
  getEnterpriseServiceByFeedPath,
} from "@/lib/enterprise-services";

interface Props {
  page: LandingPageDef;
  locale: Locale;
}

const { page, locale } = Astro.props;
const messages = loadMessages(locale);
const loc = locale;
const fromCatalog = page.fromCatalog || isCatalogContentKey(page.contentKey);

type LandingContent = {
  metaTitle: string;
  metaDescription: string;
  metaKeywords?: string[];
  eyebrow: string;
  h1: string;
  subtitle: string;
  problemsTitle: string;
  problems: string[];
  deliverablesTitle: string;
  deliverables: string[];
  relatedTitle: string;
  related: { href: string; label: string }[];
  faq?: { q: string; a: string }[];
};

let content: LandingContent;
let extended = getLandingExtended(page.contentKey, loc);

if (fromCatalog) {
  const catalogContent = getCatalogLandingContent(page.contentKey, loc);
  if (!catalogContent) throw new Error(`Missing catalog content for ${page.contentKey}`);
  content = catalogContent;
  extended = getCatalogLandingExtended(page.contentKey, loc) ?? extended;
} else {
  const pages = (messages as { landing?: { pages?: Record<string, LandingContent> } }).landing
    ?.pages;
  content = pages?.[page.contentKey] as LandingContent;
  if (!content) throw new Error(`Missing landing content ${page.contentKey}`);
}

const catalogService = getEnterpriseService(page.serviceSlug, locale);
const feedOffer = getEnterpriseServiceByFeedPath(`/${page.category}/${page.slug}`, locale);
const commercial = feedOffer ?? catalogService;
const faqItems = extended?.faq ?? content.faq ?? [];
const canonicalPath = localizePath(`/${page.category}/${page.slug}`, locale);
---

<BaseLayout
  title={content.metaTitle}
  description={content.metaDescription}
  locale={locale}
  canonicalPath={canonicalPath}
  keywords={"metaKeywords" in content && Array.isArray(content.metaKeywords) ? content.metaKeywords : []}
>
  <article class="container-editorial py-12 md:py-20">
    <p class="meta-label">{content.eyebrow}</p>
    <h1 class="mt-4 display-title">{content.h1}</h1>
    <p class="mt-6 body-copy max-w-3xl">{content.subtitle}</p>

    {
      commercial?.serviceImage && (
        <figure class="landing-hero-media mt-10 editorial-image editorial-image--hero overflow-hidden rounded">
          <img
            src={commercial.serviceImage}
            alt={content.h1}
            class="hero-media__image h-full w-full object-cover"
            width="1400"
            height="600"
            fetchpriority="high"
            decoding="async"
          />
        </figure>
      )
    }

    {
      commercial && (
        <p class="mt-4 text-sm text-muted">
          {commercial.salesNotes}
          {locale === "uz" ? " · from " : " · от "}
          {commercial.price.toLocaleString(locale === "uz" ? "en-US" : "ru-RU")}
          {locale === "uz" ? " ₽" : " ₽"}
        </p>
      )
    }

    <div class="mt-8 flex flex-wrap gap-3">
      {
        commercial ? (
          <a href={localizePath(`/order/${commercial.slug}`, locale)} class="btn-primary">
            {messages.order.title}
          </a>
        ) : (
          <a href="#order" class="btn-primary">
            {messages.order.title}
          </a>
        )
      }
      <button
        type="button"
        class="btn-secondary"
        data-contact-open
        data-contact-goal="primary_cta_click"
        data-contact-service={commercial?.title ?? content.h1}
      >
        {messages.contact.title}
      </button>
    </div>

    <ServiceAudienceBand locale={locale} messages={messages} variant="plain" />

    <section class="mt-14">
      <h2 class="section-title">{content.problemsTitle}</h2>
      <ul class="mt-6 space-y-3">
        {content.problems.map((item) => (
          <li class="body-copy flex gap-3">
            <span class="text-accent" aria-hidden>
              —
            </span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </section>

    <section class="mt-14">
      <h2 class="section-title">{content.deliverablesTitle}</h2>
      <ul class="mt-6 space-y-3">
        {content.deliverables.map((item) => (
          <li class="body-copy flex gap-3">
            <span class="text-accent" aria-hidden>
              —
            </span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </section>

    {
      faqItems.length > 0 && (
        <section class="mt-14">
          <h2 class="section-title">{locale === "uz" ? "FAQ" : "Частые вопросы"}</h2>
          <div class="mt-6 space-y-6">
            {faqItems.map((item) => (
              <div>
                <h3 class="font-medium text-ink">{item.q}</h3>
                <p class="mt-2 body-copy text-muted">{item.a}</p>
              </div>
            ))}
          </div>
        </section>
      )
    }

    {
      content.related?.length > 0 && (
        <section class="mt-14">
          <h2 class="section-title">{content.relatedTitle}</h2>
          <nav class="mt-6 flex flex-wrap gap-4">
            {content.related.map((item) => (
              <a class="text-link" href={localizePath(item.href, locale)}>
                {item.label}
              </a>
            ))}
          </nav>
        </section>
      )
    }

    <section id="order" class="mt-16 border-t border-hairline pt-12">
      <p class="meta-label">{messages.order.metaLabel}</p>
      <h2 class="section-title mt-2">{messages.order.title}</h2>
      <p class="mt-3 body-copy text-sm text-muted max-w-xl">{messages.order.sectionHint}</p>
      <div class="mt-8 max-w-xl">
        <ContactForm
          locale={locale}
          messages={messages}
          intent="order"
          defaultService={commercial?.title ?? content.h1}
          source={`landing-order-${page.category}-${page.slug}`}
          qualify
        />
      </div>
    </section>

    <section id="estimate" class="mt-16 border-t border-hairline pt-12">
      <p class="meta-label">{messages.nav.contact}</p>
      <h2 class="section-title mt-2">{messages.contact.title}</h2>
      <p class="mt-3 body-copy text-sm text-muted max-w-xl">{messages.contact.subtitle}</p>
      <div class="mt-8 max-w-xl">
        <ContactForm
          locale={locale}
          messages={messages}
          intent="estimate"
          defaultService={commercial?.title ?? content.h1}
          source={`landing-estimate-${page.category}-${page.slug}`}
          qualify
        />
      </div>
    </section>
  </article>
</BaseLayout>
