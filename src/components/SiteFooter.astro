---
import { localizePath, type Locale } from "@/lib/i18n";
import {
  LEGAL_ENTITY,
  LEGAL_ROUTES,
  formatLegalRequisitesLine,
  legalAddressForLocale,
} from "@/lib/legal";
import {
  CONTACT_PHONE,
  HOMEPAGE_PRESENCE_LINKS,
  SITE_NAME,
  SITE_URL,
  TELEGRAM_URL,
} from "@/lib/site";
import type { Messages } from "@/lib/i18n";
import BitrixPartnerBadge from "@/components/BitrixPartnerBadge.astro";

interface Props {
  locale: Locale;
  messages: Messages;
}

const { locale, messages } = Astro.props;
const footer = messages.footer;
const nav = messages.nav;

const sectionLinks = [
  { href: "/automation", label: nav.automation, localeAgnostic: false },
  { href: "/services", label: nav.services, localeAgnostic: false },
  { href: "/portfolio", label: nav.portfolio, localeAgnostic: false },
  { href: "/secure-ai", label: nav.secureAi, localeAgnostic: false },
  { href: "/ai-kubernetes", label: nav.aiKubernetes, localeAgnostic: false },
  { href: "/claude", label: nav.claude, localeAgnostic: false },
  { href: "/ii-dlya-biznesa", label: nav.iiDlyaBiznesa, localeAgnostic: false },
  { href: "/about", label: nav.about, localeAgnostic: false },
  { href: "/career", label: nav.career, localeAgnostic: false },
  { href: "/pricing", label: nav.pricing, localeAgnostic: false },
  { href: "/blog", label: nav.blog, localeAgnostic: false },
  { href: "/academy", label: nav.academy, localeAgnostic: true },
  { href: "/media", label: nav.media, localeAgnostic: false },
  { href: "/guides", label: nav.guides, localeAgnostic: false },
  { href: "/faq", label: nav.faq, localeAgnostic: false },
  { href: "/#contact", label: nav.contact, localeAgnostic: false },
];

function hrefFor(item: { href: string; localeAgnostic?: boolean }) {
  return item.localeAgnostic ? item.href : localizePath(item.href, locale);
}

const year = new Date().getFullYear();
---

<footer class="footer-dark">
  <div class="container-editorial">
    <div class="mb-8">
      <span class="site-wordmark text-ink">{SITE_NAME}</span>
    </div>
    <p class="meta-label text-on-dark-soft">{footer.sectionsTitle}</p>
    <nav class="mt-3 flex flex-wrap gap-x-5 gap-y-2 text-sm" aria-label={footer.sectionsTitle}>
      {sectionLinks.map((item) => (
        <a href={hrefFor(item)} class="text-on-dark active:opacity-75">
          {item.label}
        </a>
      ))}
    </nav>
    <p class="mt-8 text-sm">
      <span class="text-on-dark">{footer.legalName}</span>
      {" · "}
      {formatLegalRequisitesLine(locale)}
    </p>
    <p class="mt-2 text-sm text-on-dark-soft">{legalAddressForLocale(locale)}</p>
    <div class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-sm">
      <a href={localizePath(LEGAL_ROUTES.terms, locale)} class="text-on-dark-soft active:text-on-dark">
        {footer.terms}
      </a>
      <a href={localizePath(LEGAL_ROUTES.privacyPolicy, locale)} class="text-on-dark-soft active:text-on-dark">
        {footer.privacy}
      </a>
      <a href={localizePath(LEGAL_ROUTES.consent, locale)} class="text-on-dark-soft active:text-on-dark">
        {footer.consent}
      </a>
      <a href={`mailto:${LEGAL_ENTITY.email}`} class="text-on-dark-soft active:text-on-dark">
        {LEGAL_ENTITY.email}
      </a>
      <a href={TELEGRAM_URL} target="_blank" rel="noreferrer" class="text-on-dark-soft active:text-on-dark">
        Telegram
      </a>
      <a href={`tel:${CONTACT_PHONE}`} class="text-on-dark-soft active:text-on-dark">
        {CONTACT_PHONE}
      </a>
    </div>
    <p class="mt-6 text-xs text-on-dark-soft">{footer.profiles}</p>
    <div class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-xs">
      {HOMEPAGE_PRESENCE_LINKS.map((item) => (
        <a
          href={item.url}
          target="_blank"
          rel="me noreferrer"
          class={`text-on-dark-soft active:text-on-dark${item.id === "linkedin" ? " font-medium text-on-dark" : ""}`}
        >
          {footer.presence[item.id as keyof typeof footer.presence]}
        </a>
      ))}
    </div>
    <p class="mt-8 text-xs text-muted-soft">© {year} {SITE_NAME}</p>
    <div class="mt-4">
      <BitrixPartnerBadge locale={locale} variant="footer" loading="lazy" />
    </div>
    <div class="mt-4 flex flex-wrap items-center gap-3">
      <a
        href={`https://webmaster.yandex.ru/siteinfo/?site=${encodeURIComponent(SITE_URL)}`}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block"
        title={footer.sqiTitle}
      >
        <img
          src={`https://yandex.ru/cycounter?${SITE_URL}&theme=dark&lang=ru`}
          width={88}
          height={31}
          alt={footer.sqiAltDark}
          class="rounded-lg"
          loading="lazy"
          decoding="async"
          referrerpolicy="no-referrer"
        />
      </a>
      <a
        href={`https://webmaster.yandex.ru/siteinfo/?site=${encodeURIComponent(SITE_URL)}`}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block"
        title={footer.sqiTitle}
      >
        <img
          src={`https://yandex.ru/cycounter?${SITE_URL}&theme=light&lang=ru`}
          width={88}
          height={31}
          alt={footer.sqiAltLight}
          class="rounded-lg"
          loading="lazy"
          decoding="async"
          referrerpolicy="no-referrer"
        />
      </a>
    </div>
  </div>
</footer>
