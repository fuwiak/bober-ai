---
/**
 * Bober support chat — Unitool-style panel, house tokens (lime / slate).
 * Canned replies + Telegram / contact handoff. No purple, no LLM API.
 */
import { TELEGRAM_URL } from "@/lib/site";

interface Props {
  title?: string;
  status?: string;
  welcome?: string;
  chips?: readonly string[];
  telegramUrl?: string;
}

const {
  title = "AI-ассистент Bober",
  status = "онлайн",
  welcome = "Подскажу по пилоту, стоимости и внедрению Secure AI × Kaspersky. Чем помочь?",
  chips = ["Стоимость пилота", "KUMA и KIRA", "Связаться"],
  telegramUrl = TELEGRAM_URL,
} = Astro.props;
---

<div
  class="support-chat"
  data-support-chat
  data-open="false"
  data-telegram={telegramUrl}
>
  <button
    type="button"
    class="support-chat__launcher"
    data-support-open
    aria-expanded="false"
    aria-controls="support-chat-panel"
    data-goal="support_chat_open"
  >
    <span class="support-chat__launcher-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none">
        <path
          d="M5 6.5A2.5 2.5 0 0 1 7.5 4h9A2.5 2.5 0 0 1 19 6.5v7A2.5 2.5 0 0 1 16.5 16H10l-3.8 3.2c-.6.5-1.5.1-1.5-.7V6.5Z"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linejoin="round"
        />
        <path
          d="M8.5 9.25h7M8.5 12.25h4.5"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
        />
      </svg>
    </span>
    <span class="support-chat__launcher-label">Спросить</span>
  </button>

  <section
    id="support-chat-panel"
    class="support-chat__panel"
    data-support-panel
    hidden
    role="dialog"
    aria-modal="false"
    aria-label={title}
  >
    <header class="support-chat__head">
      <div class="support-chat__brand" aria-hidden="true"><span>B</span></div>
      <div class="support-chat__head-text">
        <p class="support-chat__title">{title}</p>
        <p class="support-chat__status">
          <span class="support-chat__dot" aria-hidden="true"></span>
          {status}
        </p>
      </div>
      <button
        type="button"
        class="support-chat__close"
        data-support-close
        aria-label="Закрыть чат"
      >
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
          <path
            d="M6.5 6.5 17.5 17.5M17.5 6.5 6.5 17.5"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
          ></path>
        </svg>
      </button>
    </header>

    <div class="support-chat__scroll" data-support-scroll>
      <div class="support-chat__row support-chat__row--bot">
        <div class="support-chat__avatar" aria-hidden="true"><span>B</span></div>
        <div class="support-chat__bubble support-chat__bubble--bot">
          <p>{welcome}</p>
        </div>
      </div>
      {
        chips.length ? (
          <div class="support-chat__chips" role="group" aria-label="Быстрые вопросы">
            {chips.map((chip) => (
              <button type="button" class="support-chat__chip" data-support-chip={chip}>
                {chip}
              </button>
            ))}
          </div>
        ) : null
      }
    </div>

    <form class="support-chat__composer" data-support-form>
      <div class="support-chat__field">
        <textarea
          class="support-chat__input"
          data-support-input
          rows="1"
          placeholder="Спросите про пилот, цену или внедрение…"
          aria-label="Сообщение"
        ></textarea>
        <button
          type="submit"
          class="support-chat__send"
          data-support-send
          disabled
          aria-label="Отправить"
        >
          <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true">
            <path
              d="M4.2 12.1 19.5 4.8c.7-.3 1.4.4 1.1 1.1L13.3 20c-.3.7-1.3.6-1.5-.2l-1.5-5.3-5.3-1.5c-.8-.2-.9-1.2-.2-1.5Z"
              fill="currentColor"
            ></path>
          </svg>
        </button>
      </div>
      <p class="support-chat__hint">Enter — отправить · Shift+Enter — новая строка</p>
    </form>
  </section>
</div>

<script>
  import { initSupportChat } from "../scripts/support-chat";
  initSupportChat();
</script>
