---
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import CookieConsent from "@/components/CookieConsent.astro";
import ContactModal from "@/components/ContactModal.astro";
import ContactFab from "@/components/ContactFab.astro";
import { loadMessages, localizePath, stripLocalePrefix, type Locale } from "@/lib/i18n";
import { marketOf } from "@/lib/markets";
import {
  AMOCRM_YANDEX_METRIKA_ID,
  BITRIX_YANDEX_METRIKA_ID,
  PARTNERS_YANDEX_METRIKA_ID,
  YANDEX_METRIKA_ID,
} from "@/lib/legal";
import { getSeoIndexPolicy } from "@/lib/seo-index-policy";
import { absoluteUrl, OG_IMAGE, SITE_NAME } from "@/lib/site";
import "../styles/globals.css";

interface Props {
  title: string;
  description: string;
  locale: Locale;
  canonicalPath: string;
  keywords?: string[];
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Opt-out of indexing when needed. */
  noIndex?: boolean;
}

const { title, description, locale, canonicalPath, keywords = [], jsonLd, noIndex = false } = Astro.props;
const market = marketOf(locale);
const barePath = stripLocalePrefix(canonicalPath);
/**
 * Self-canonical only. Hard duplicates → 301 (seo-redirects), not cross-canonical.
 * /order/* and explicit noIndex → noindex,follow.
 * Hreflang: ru-RU + kz hub/pricing only (UZ redirected away).
 */
const indexPolicy = getSeoIndexPolicy(barePath);
const effectiveNoIndex = noIndex || Boolean(indexPolicy?.noIndex);
const preferredCanonicalPath = canonicalPath;
const hreflangLocales: Locale[] = (() => {
  const out: Locale[] = ["ru"];
  if (barePath === "/" || barePath === "/pricing") out.push("kz");
  return out;
})();
const geoPosition = `${market.geo.latitude};${market.geo.longitude}`;
const geoIcbm = `${market.geo.latitude}, ${market.geo.longitude}`;
const geoPlacename = market.placename;
const messages = loadMessages(locale);
const canonical = absoluteUrl(preferredCanonicalPath);
const ogImage = absoluteUrl(OG_IMAGE);
const robotsContent = effectiveNoIndex
  ? "noindex, follow"
  : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1";
const metrikaBootstrap = `(function(){var host=(location.hostname||'').toLowerCase();var path=location.pathname||'';var onSystems=host==='www.bober-systems.ru'||host==='bober-systems.ru'||host==='partners.bober-systems.ru'||host==='bitrix.bober-systems.ru'||host==='amocrm.bober-systems.ru'||/\\.bober-systems\\.ru$/.test(host);if(!onSystems){window.__boberYmId=null;return;}var mainId=${YANDEX_METRIKA_ID};var partnersId=${PARTNERS_YANDEX_METRIKA_ID};var bitrixId=${BITRIX_YANDEX_METRIKA_ID};var amocrmId=${AMOCRM_YANDEX_METRIKA_ID};var id=(host==='partners.bober-systems.ru'||path.indexOf('/white-label')===0)?partnersId:((host==='bitrix.bober-systems.ru'||path.indexOf('/bitrix')===0)?bitrixId:(host==='amocrm.bober-systems.ru'?amocrmId:mainId));window.__boberYmId=id;window.dataLayer=window.dataLayer||[];(function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};m[i].l=1*new Date();for(var j=0;j<document.scripts.length;j++){if(document.scripts[j].src===r)return;}k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)})(window,document,'script','https://mc.yandex.ru/metrika/tag.js?id='+id,'ym');ym(id,'init',{ssr:true,webvisor:true,clickmap:true,trackLinks:true,accurateTrackBounce:true,trackHash:true,ecommerce:'dataLayer',referrer:document.referrer,url:location.href});})();`;
---

<!doctype html>
<html lang={market.htmlLang} class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords.length > 0 && <meta name="keywords" content={keywords.join(", ")} />}
    <meta name="robots" content={robotsContent} />
    <meta name="geo.region" content={market.geoRegion} />
    <meta name="geo.placename" content={geoPlacename} />
    <meta name="geo.position" content={geoPosition} />
    <meta name="ICBM" content={geoIcbm} />
    <meta name="yandex-verification" content="0e71ef3fc54b6c3c" />
    <meta name="yandex-verification" content="b5643e127be991c8" />
    <link rel="canonical" href={canonical} />
    {hreflangLocales.map((l) => (
      <link
        rel="alternate"
        hreflang={marketOf(l).hreflang}
        href={absoluteUrl(localizePath(barePath, l))}
      />
    ))}
    <link rel="alternate" hreflang="x-default" href={absoluteUrl(localizePath(barePath, "ru"))} />
    <link rel="alternate" type="application/rss+xml" title={`${SITE_NAME} RSS`} href={absoluteUrl("/rss.xml")} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon-16x16.png" type="image/png" sizes="16x16" />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-120x120.png" type="image/png" sizes="120x120" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/apple-icon.png" sizes="180x180" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#000000" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={market.ogLocale} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://mc.yandex.ru" crossorigin />

    <script is:inline>
      (function () {
        try {
          var k = "theme";
          var t = localStorage.getItem(k);
          var d = t !== "light";
          document.documentElement.classList.toggle("dark", d);
        } catch (e) {
          document.documentElement.classList.add("dark");
        }
      })();
    </script>
    <script is:inline set:html={metrikaBootstrap} />
    <noscript>
      <div>
        <img
          src={`https://mc.yandex.ru/watch/${YANDEX_METRIKA_ID}`}
          style="position:absolute;left:-9999px;"
          alt=""
        />
      </div>
    </noscript>

    {Array.isArray(jsonLd)
      ? jsonLd.map((block) => (
          <script type="application/ld+json" set:html={JSON.stringify(block)} />
        ))
      : jsonLd && (
          <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
        )}
  </head>
  <body
    hx-boost="true"
    style="--font-manrope: 'Manrope', system-ui, sans-serif; --font-ibm-plex-mono: 'IBM Plex Mono', ui-monospace, monospace;"
  >
    <SiteHeader locale={locale} messages={messages} />
    <main>
      <slot />
    </main>
    <SiteFooter locale={locale} messages={messages} />
    <ContactModal locale={locale} messages={messages} />
    <ContactFab messages={messages} />
    <CookieConsent locale={locale} messages={messages} />

    <script src="/vendor/htmx.min.js" is:inline></script>
    <script>
      import "../scripts/theme.ts";
      import "../scripts/nav.ts";
      import "../scripts/attribution.ts";
      import "../scripts/cookie-consent.ts";
      import "../scripts/contact-modal.ts";
      import "../scripts/form-attribution.ts";
      import "../scripts/goal-clicks.ts";
      import "../scripts/metrika-hits.ts";
      import "../scripts/roi-calculator.ts";
      import "../scripts/process-review-form.ts";
      import "../scripts/reveal.ts";
      import "../scripts/contact-form-ab.ts";
    </script>
  </body>
</html>
