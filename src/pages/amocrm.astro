---
/**
 * amoCRM hub — /amocrm (parallel to /bitrix).
 * Keeps short commercial URL for market-offers and ads.
 */
import SeoServicePage from "@/components/SeoServicePage.astro";
import { AMOCRM_LANDING_KEYWORDS, AMOCRM_SEO_CONTENT } from "@/lib/amocrm-landing";

export const prerender = true;
---

<SeoServicePage
  slug="amocrm"
  locale="ru"
  content={AMOCRM_SEO_CONTENT}
  pagePath="/amocrm"
  serviceSlug="amocrm-setup"
  keywords={[...AMOCRM_LANDING_KEYWORDS]}
  formSource="amocrm-landing"
  formDefaultService="amoCRM / внедрение и настройка"
  breadcrumbItems={[
    { name: "Услуги", path: "/services" },
    { name: "amoCRM", path: "/amocrm" },
  ]}
/>
