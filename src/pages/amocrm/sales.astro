---
/**
 * Отдельный лендинг: автоматизация воронки продаж в amoCRM.
 */
import SeoServicePage from "@/components/SeoServicePage.astro";
import { AMOCRM_SALES_CONTENT, AMOCRM_SALES_KEYWORDS } from "@/lib/amocrm-landing";

export const prerender = true;
---

<SeoServicePage
  slug="amocrm-sales"
  locale="ru"
  content={AMOCRM_SALES_CONTENT}
  pagePath="/amocrm/sales"
  serviceSlug="crm-automation"
  keywords={[...AMOCRM_SALES_KEYWORDS]}
  formSource="amocrm-sales-landing"
  formDefaultService="amoCRM / автоматизация воронки продаж"
  breadcrumbItems={[
    { name: "Услуги", path: "/services" },
    { name: "amoCRM", path: "/amocrm" },
    { name: "Автоматизация воронки", path: "/amocrm/sales" },
  ]}
/>
