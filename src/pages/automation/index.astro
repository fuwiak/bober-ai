---
/**
 * Автоматизация бизнес-процессов — SeoServicePage (каталог + коммерческий оффер).
 * Content: src/lib/automation-page.ts → getAutomationSeoContent.
 * Child landings under /automation/[slug] use SeoServicePage via landing-seo-service.
 */
import SeoServicePage from "@/components/SeoServicePage.astro";
import {
  AUTOMATION_DIRECTIONS,
  AUTOMATION_PAGE,
  getAutomationSeoContent,
} from "@/lib/automation-page";
import { localizePath } from "@/lib/i18n";

export const prerender = true;

const locale = "ru" as const;
const content = getAutomationSeoContent(locale);
const p = AUTOMATION_PAGE;
const orderHref = localizePath("/services/business-process-automation", locale);
---

<SeoServicePage
  slug="automation"
  serviceSlug="automation"
  locale={locale}
  content={content}
  pagePath="/automation"
  keywords={[...p.metaKeywordsRu]}
  formSource="automation-landing"
  formDefaultService="Автоматизация бизнес-процессов"
  breadcrumbItems={[
    { name: "Услуги", path: "/services" },
    { name: p.lineRu, path: "/automation" },
  ]}
>
  <div slot="before-contact">
    <section id="directions" class="section-band border-b border-hairline">
      <div class="container-editorial max-w-4xl">
        <span class="section-label">{p.directionsLabelRu}</span>
        <h2 class="section-title mt-4 max-w-2xl">{p.directionsTitleRu}</h2>
        <p class="body-copy mt-4 max-w-2xl">{p.directionsSubtitleRu}</p>
        <ul class="mt-8 grid gap-4 sm:grid-cols-2">
          {
            AUTOMATION_DIRECTIONS.map((item) => (
              <li class="border border-hairline bg-surface-card p-5">
                <a
                  class="font-medium text-link"
                  href={localizePath(item.href, locale)}
                  data-goal="automation_direction_click"
                >
                  {item.labelRu}
                </a>
                <p class="mt-2 text-sm text-muted">{item.blurbRu}</p>
              </li>
            ))
          }
        </ul>
        <p class="mt-8">
          <a href={orderHref} class="btn-secondary" data-goal="automation_order_cta">
            {p.orderCtaRu}
          </a>
        </p>
      </div>
    </section>
  </div>
</SeoServicePage>
