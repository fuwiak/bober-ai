---
/**
 * Blog article.
 *
 * The template used to render `sections` only, so every intent article lost its
 * checklist / code snippet / comparison table (the anti-thin-content artifacts),
 * its FAQ block, its related links and all schema. That silently affected ~80
 * articles at once — hence the render below covers the whole IntentArticleSpec.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import ContactForm from "@/components/ContactForm.astro";
import { loadMessages, localizePath } from "@/lib/i18n";
import { getAllIntentArticles, getIntentArticle } from "@/lib/seo-catalog";
import { BLOG_POSTS } from "@/lib/blog-posts";
import { PROFILE } from "@/lib/profile";
import { absoluteUrl } from "@/lib/site";
import { articleJsonLd, faqJsonLd } from "@/lib/seo";

export const prerender = true;

export function getStaticPaths() {
  const intent = getAllIntentArticles().map((a) => a.slug);
  const posts = BLOG_POSTS.map((p) => p.slug);
  return [...new Set([...intent, ...posts])].map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const locale = "ru" as const;
const messages = loadMessages(locale);
const intent = getIntentArticle(slug!);
const post = BLOG_POSTS.find((p) => p.slug === slug);
const copy = intent?.ru;

const title = copy?.title || post?.title || slug!;
const description = copy?.description || post?.description || messages.meta.description;
const h1 = copy?.h1 || title;
const pageUrl = absoluteUrl(`/blog/${slug}`);
const related = intent?.related ?? [];
const faq = copy?.faq ?? [];

/** schema.org Article wants the body text, not only the headline. */
const articleText = [
  description,
  ...(copy?.sections ?? []).flatMap((section) => [section.title, ...section.paragraphs]),
]
  .join(" ")
  .slice(0, 5000);

const jsonLd = [
  articleJsonLd({
    type: "BlogPosting",
    url: pageUrl,
    headline: h1,
    text: articleText || description,
    description,
    authorName: PROFILE.name,
    datePublished: intent?.publishedAt || post?.publishedAt,
    image: post?.coverImage,
    inLanguage: "ru-RU",
    about: intent?.keywords?.slice(0, 6),
  }),
  ...(faq.length ? [faqJsonLd(faq, pageUrl)] : []),
];
---

<BaseLayout
  title={title}
  description={description}
  locale={locale}
  canonicalPath={`/blog/${slug}`}
  keywords={intent?.keywords ?? post?.tags ?? []}
  jsonLd={jsonLd}
>
  <article class="container-editorial py-12 md:py-20">
    <Breadcrumbs
      locale={locale}
      items={[
        { name: messages.nav.blog, path: "/blog" },
        { name: h1, path: `/blog/${slug}` },
      ]}
    />
    <p class="mt-6 meta-label">{messages.nav.blog}</p>
    <h1 class="mt-4 display-title" id="article">{h1}</h1>
    <p class="mt-6 body-copy max-w-3xl text-muted">{description}</p>

    {
      copy?.sections?.map((section) => (
        <section class="mt-10">
          <h2 class="section-title">{section.title}</h2>
          {section.paragraphs.map((p) => (
            <p class="mt-4 body-copy max-w-3xl">{p}</p>
          ))}
        </section>
      ))
    }

    {
      copy?.checklist && (
        <section class="mt-12 border border-hairline p-6">
          <h2 class="section-title">{copy.checklist.title}</h2>
          <ul class="mt-4 space-y-2">
            {copy.checklist.items.map((item) => (
              <li class="body-copy flex gap-3">
                <span class="text-accent">—</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      copy?.comparisonTable && (
        <section class="mt-12">
          <h2 class="section-title">{copy.comparisonTable.title}</h2>
          <div class="mt-4 overflow-x-auto">
            <table class="w-full min-w-[36rem] border-collapse text-sm">
              <thead>
                <tr>
                  {copy.comparisonTable.headers.map((header) => (
                    <th class="border-b border-hairline py-3 pr-4 text-left font-medium text-ink">
                      {header}
                    </th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {copy.comparisonTable.rows.map((row) => (
                  <tr>
                    {row.map((cell) => (
                      <td class="border-b border-hairline py-3 pr-4 align-top text-muted">{cell}</td>
                    ))}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      )
    }

    {
      copy?.codeSnippet && (
        <section class="mt-12">
          <h2 class="section-title">{copy.codeSnippet.title}</h2>
          <pre class="mt-4 overflow-x-auto border border-hairline p-4 text-sm"><code>{copy.codeSnippet.code}</code></pre>
        </section>
      )
    }

    {
      post?.contentHtml && (
        <div class="mt-10 blog-article max-w-3xl" set:html={post.contentHtml} />
      )
    }

    {
      faq.length > 0 && (
        <section class="mt-14">
          <h2 class="section-title">FAQ</h2>
          <div class="mt-6 space-y-6">
            {faq.map((item) => (
              <div>
                <h3 class="font-medium text-ink">{item.q}</h3>
                <p class="mt-2 body-copy text-muted">{item.a}</p>
              </div>
            ))}
          </div>
        </section>
      )
    }

    {
      related.length > 0 && (
        <section class="mt-14 border-t border-hairline pt-8">
          <h2 class="section-title">Связанные решения</h2>
          <ul class="mt-4 flex flex-wrap gap-x-6 gap-y-2">
            {related.map((item) => (
              <li>
                <a class="link-more" href={localizePath(item.href, locale)}>
                  {item.labelRu} →
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section id="contact" class="mt-16 border-t border-hairline pt-12">
      <h2 class="section-title">{messages.nav.contact}</h2>
      <div class="mt-8 max-w-xl"><ContactForm locale={locale} messages={messages} /></div>
    </section>
  </article>
</BaseLayout>
