---
/**
 * Claude AI landing — SeoServicePage parity with Next /claude.
 * Content: src/lib/claude-page.ts → getClaudeSeoContent.
 */
import SeoServicePage from "@/components/SeoServicePage.astro";
import { CLAUDE_PAGE, getClaudeSeoContent } from "@/lib/claude-page";
import { localizePath } from "@/lib/i18n";

export const prerender = true;

const locale = "ru" as const;
const content = getClaudeSeoContent(locale);
const p = CLAUDE_PAGE;
const glossaryHref = localizePath(p.glossaryHref, locale);
---

<SeoServicePage
  slug="claude-smb"
  serviceSlug="claude-smb"
  locale={locale}
  content={content}
  pagePath="/claude"
  keywords={[...p.metaKeywordsRu]}
  formSource="claude-landing"
  formDefaultService="Claude AI / внедрение"
  breadcrumbItems={[
    { name: "Услуги", path: "/services" },
    { name: p.lineRu, path: "/claude" },
  ]}
>
  <div slot="before-contact">
    <section class="section-band section--deep border-b border-hairline">
      <div class="container-editorial max-w-3xl">
        <span class="section-label">{p.popularLabelRu}</span>
        <ul class="mt-6 flex flex-wrap gap-2">
          {
            p.terms.map((term) => (
              <li class="rounded border border-hairline bg-surface-card px-3 py-1.5 text-sm text-body">
                {term}
              </li>
            ))
          }
        </ul>
        <p class="mt-6">
          <a href={glossaryHref} class="link-more">{p.glossaryLabelRu}</a>
        </p>
      </div>
    </section>
  </div>
</SeoServicePage>
