---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ContactForm from "@/components/ContactForm.astro";
import { loadMessages } from "@/lib/i18n";
import { getAllIntentArticles, getIntentArticle } from "@/lib/seo-catalog";
import { BLOG_POSTS } from "@/lib/blog-posts";

export const prerender = true;

export function getStaticPaths() {
  const intent = getAllIntentArticles().map((a) => a.slug);
  const posts = BLOG_POSTS.map((p) => p.slug);
  return [...new Set([...intent, ...posts])].map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const locale = "en" as const;
const messages = loadMessages(locale);
const intent = getIntentArticle(slug!);
const post = BLOG_POSTS.find((p) => p.slug === slug);
const copy = intent?.en;

const title = copy?.title || post?.title || slug!;
const description = copy?.description || post?.description || messages.meta.description;
---

<BaseLayout title={title} description={description} locale={locale} canonicalPath={`/en/blog/${slug}`}>
  <article class="container-editorial py-12 md:py-20">
    <p class="meta-label">{messages.nav.blog}</p>
    <h1 class="mt-4 display-title">{copy?.h1 || title}</h1>
    <p class="mt-6 body-copy max-w-3xl text-muted">{description}</p>

    {
      copy?.sections?.map((section) => (
        <section class="mt-10">
          <h2 class="section-title">{section.title}</h2>
          {section.paragraphs.map((p) => (
            <p class="mt-4 body-copy max-w-3xl">{p}</p>
          ))}
        </section>
      ))
    }

    {
      post?.contentHtml && (
        <div class="mt-10 blog-article max-w-3xl" set:html={post.contentHtml} />
      )
    }

    <section id="contact" class="mt-16 border-t border-hairline pt-12">
      <h2 class="section-title">{messages.nav.contact}</h2>
      <div class="mt-8 max-w-xl"><ContactForm locale={locale} messages={messages} /></div>
    </section>
  </article>
</BaseLayout>
