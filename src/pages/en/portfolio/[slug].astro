---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ContactForm from "@/components/ContactForm.astro";
import { loadMessages, type Locale } from "@/lib/i18n";
import { getPortfolioItem, getPortfolioListing } from "@/lib/profile";

export const prerender = true;

export function getStaticPaths() {
  return getPortfolioListing("en").map((item) => ({
    params: { slug: item.slug },
    props: { locale: "en" as Locale },
  }));
}

const { slug } = Astro.params;
const locale = "en" as const;
const messages = loadMessages(locale);
const item = getPortfolioItem(slug!, locale);
if (!item) return Astro.redirect("/en/portfolio");
---

<BaseLayout
  title={`${item.title} — Bober AI`}
  description={item.description || messages.meta.description}
  locale={locale}
  canonicalPath={`/en/portfolio/${item.slug}`}
>
  <article class="container-editorial py-12 md:py-20">
    <p class="meta-label">{messages.nav.portfolio}</p>
    <h1 class="mt-4 display-title">{item.title}</h1>
    {item.metric && <p class="mt-4 text-accent">{item.metric}</p>}
    {
      item.image && (
        <figure class="landing-hero-media mt-10 editorial-image editorial-image--hero overflow-hidden rounded">
          <img
            src={item.image}
            alt={item.imageAlt || item.title}
            class="hero-media__image h-full w-full object-cover"
            width="1400"
            height="600"
            fetchpriority="high"
            decoding="async"
          />
          {item.imageCaption && <figcaption class="mt-3 text-sm text-muted">{item.imageCaption}</figcaption>}
        </figure>
      )
    }
    {item.description && <p class="mt-6 body-copy max-w-3xl">{item.description}</p>}
    {item.solution && (
      <section class="mt-10">
        <h2 class="section-title">{messages.portfolio.solutionLabel}</h2>
        <p class="mt-4 body-copy max-w-3xl whitespace-pre-line">{item.solution}</p>
      </section>
    )}
    {item.result && (
      <section class="mt-10">
        <h2 class="section-title">{messages.portfolio.resultLabel}</h2>
        <p class="mt-4 body-copy max-w-3xl whitespace-pre-line">{item.result}</p>
      </section>
    )}
    <section id="contact" class="mt-16 border-t border-hairline pt-12">
      <h2 class="section-title">{messages.nav.contact}</h2>
      <div class="mt-8 max-w-xl"><ContactForm locale={locale} messages={messages} /></div>
    </section>
  </article>
</BaseLayout>
