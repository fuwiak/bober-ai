---
export const prerender = true;
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import PackagesShowcase from "@/components/PackagesShowcase.astro";
import RoiCalculatorSection from "@/components/RoiCalculatorSection.astro";
import ComparisonSection from "@/components/ComparisonSection.astro";
import SectionCtaBand from "@/components/SectionCtaBand.astro";
import { loadMessages, localizePath } from "@/lib/i18n";
import { LEGAL_ROUTES } from "@/lib/legal";

const locale = "en" as const;
const messages = loadMessages(locale);
const tp = messages.pages.pricing;
const packageItems = messages.packages.items.map((item) => ({
  name: item.name,
  price: item.price,
  duration: item.duration,
  forWhom: item.forWhom,
  result: item.result,
  badge: "badge" in item ? (item.badge as string | undefined) : undefined,
  featured: "featured" in item ? Boolean(item.featured) : false,
  detailsHref: "detailsHref" in item ? (item.detailsHref as string | undefined) : undefined,
}));
---

<BaseLayout
  title={tp.metaTitle}
  description={tp.metaDescription}
  locale={locale}
  canonicalPath="/en/pricing"
>
  <section class="section-band section--deep border-b border-hairline">
    <div class="container-editorial">
      <Breadcrumbs locale={locale} items={[{ name: "Pricing", path: "/pricing" }]} />
      <h1 class="display-md mt-6 max-w-3xl">{tp.h1}</h1>
      <p class="body-copy mt-4 max-w-2xl text-base">{tp.subtitle}</p>
    </div>
  </section>

  <PackagesShowcase
    locale={locale}
    label={messages.sections.engagement}
    title={messages.packages.title}
    subtitle={messages.packages.subtitle}
    items={packageItems}
    featuredLabel={messages.packages.featuredLabel}
    detailsLabel={messages.packages.detailsLabel}
    cta={messages.packages.cta}
    urgency={messages.packages.urgency}
  />

  <section class="section-band section--panel border-b border-hairline">
    <div class="container-editorial max-w-3xl">
      <span class="section-label">{messages.budgetGate.label}</span>
      <h2 class="section-title mt-4">{messages.budgetGate.title}</h2>
      <p class="meta-label mt-6">{messages.budgetGate.whyLabel}</p>
      <ul class="mt-4 space-y-3">
        {
          messages.budgetGate.reasons.map((item) => (
            <li class="body-copy flex gap-4 text-base">
              <span class="meta-label shrink-0">—</span>
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
      <p class="body-copy mt-6 text-sm text-muted">{messages.budgetGate.note}</p>
      <button type="button" class="btn-primary mt-6" data-contact-open data-contact-goal="budget_gate_cta_click">
        {messages.budgetGate.cta}
      </button>
    </div>
  </section>

  <section class="section-band section--deep border-b border-hairline">
    <div class="container-editorial max-w-3xl">
      <span class="section-label">Price list</span>
      <h2 class="section-title mt-4">Service prices</h2>
      <p class="body-copy mt-4 max-w-2xl text-base">
        Starting prices. Final quote is fixed in the estimate before work starts. Payment by bank transfer under
        contract.
      </p>
      <div class="mt-8 overflow-x-auto">
        <table class="w-full min-w-[28rem] text-left text-sm">
          <thead>
            <tr class="border-b border-hairline text-muted">
              <th class="py-3 pr-4 font-medium">Service</th>
              <th class="py-3 pr-4 font-medium">Price</th>
              <th class="py-3 font-medium">Term</th>
            </tr>
          </thead>
          <tbody>
            {
              packageItems.map((item) => (
                <tr class="border-b border-hairline">
                  <td class="py-3 pr-4 text-ink">{item.name}</td>
                  <td class="py-3 pr-4 text-ink">{item.price}</td>
                  <td class="py-3 text-body">{item.duration}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="body-copy mt-6 text-sm text-muted">
        Full catalog:
        <a href={localizePath("/services", locale)} class="text-link">Services</a>
        {" · "}
        <a href={localizePath(LEGAL_ROUTES.terms, locale)} class="text-link">Service terms</a>
      </p>
    </div>
  </section>

  <RoiCalculatorSection locale={locale} messages={messages} />

  <ComparisonSection
    label={messages.comparison.label}
    title={messages.comparison.title}
    subtitle={messages.comparison.subtitle}
    items={[...messages.comparison.items]}
  />

  <ComparisonSection
    label={messages.problemSolution.label}
    title={messages.problemSolution.title}
    subtitle={messages.problemSolution.subtitle}
    items={[...messages.problemSolution.items]}
  />

  <section id="process" class="section-band section--panel scroll-mt-16 border-b border-hairline">
    <div class="container-editorial">
      <span class="section-label">{messages.sections.process}</span>
      <h2 class="section-title mt-4">{messages.process.title}</h2>
      <p class="body-copy mt-4 max-w-2xl text-base">{messages.process.subtitle}</p>
      <div class="mt-10">
        {
          messages.process.steps.map((step, index) => (
            <article class="process-row">
              <span class="editorial-row__index">{String(index + 1).padStart(2, "0")}</span>
              <div>
                <h3 class="card-title">{step.title}</h3>
                <p class="body-copy mt-3 max-w-2xl text-base">{step.text}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <SectionCtaBand
    title={messages.sectionCta.title}
    duration={messages.sectionCta.duration}
    commitment={messages.sectionCta.commitment}
    format={messages.sectionCta.format}
    cta={messages.sectionCta.cta}
    urgency={messages.sectionCta.urgency}
  />
</BaseLayout>
