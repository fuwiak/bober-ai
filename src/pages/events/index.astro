---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { DEFAULT_KEYWORDS, SITE_NAME, absoluteUrl } from "@/lib/site";

export const prerender = true;

const title = "Мероприятия";
const description = `Подборка актуальных AI-мероприятий и событий от технологических партнеров ${SITE_NAME}.`;
const keywords = [...DEFAULT_KEYWORDS, "AI мероприятия", "Yandex Cloud events", "Selectel events", "конференции ИИ"];

const events = [
  {
    title: "ML Conf Selectel",
    description: "Конференция по ML/AI-инфраструктуре, практикам внедрения и инженерным кейсам.",
    url: "https://mlconf.selectel.ru/#rega",
  },
  {
    title: "Yandex Cloud Events",
    description: "Мероприятия Yandex Cloud: вебинары, анонсы, обучающие и отраслевые события.",
    url: "https://yandex.cloud/ru/events",
  },
];

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: SITE_NAME, item: absoluteUrl("/") },
    { "@type": "ListItem", position: 2, name: "Мероприятия", item: absoluteUrl("/events") },
  ],
};

const itemListJsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: `Мероприятия ${SITE_NAME}`,
  url: absoluteUrl("/events"),
  hasPart: events.map((event) => ({
    "@type": "Event",
    name: event.title,
    description: event.description,
    eventAttendanceMode: "https://schema.org/OnlineEventAttendanceMode",
    eventStatus: "https://schema.org/EventScheduled",
    url: event.url,
    organizer: { "@type": "Organization", name: SITE_NAME },
  })),
};
---

<BaseLayout
  title={title}
  description={description}
  locale="ru"
  canonicalPath="/events"
  keywords={keywords}
  jsonLd={[breadcrumbJsonLd, itemListJsonLd]}
>
  <section class="container-editorial py-12 md:py-20">
    <div class="mb-10 flex flex-wrap items-center justify-between gap-4">
      <div>
        <p class="meta-label">{SITE_NAME}</p>
        <h1 class="mt-2 display-title">Мероприятия</h1>
        <p class="mt-3 max-w-2xl body-copy text-muted">
          Подборка актуальных AI-мероприятий наших технологических партнеров.
        </p>
      </div>
      <a href="/" class="btn-secondary text-sm uppercase tracking-widest">На главную</a>
    </div>

    <div class="grid gap-6 md:grid-cols-2">
      {
        events.map((event) => (
          <a
            href={event.url}
            target="_blank"
            rel="noreferrer"
            class="border border-hairline bg-surface p-6 transition hover:border-primary/40"
          >
            <span class="meta-label text-primary">external</span>
            <h2 class="mt-4 text-xl font-bold">{event.title}</h2>
            <p class="mt-2 text-sm text-muted">{event.description}</p>
            <p class="mt-4 break-all text-sm text-link">{event.url}</p>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
