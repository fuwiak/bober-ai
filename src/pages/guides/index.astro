---
/**
 * Guides hub. Previously static copy only — guides were orphan pages.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import { loadMessages, localizePath } from "@/lib/i18n";
import { GUIDES } from "@/lib/guides";
import { getGuideContent } from "@/lib/guides-content";
import { absoluteUrl } from "@/lib/site";
import { webPageJsonLd } from "@/lib/seo";

export const prerender = true;

const locale = "ru" as const;
const messages = loadMessages(locale);
const block = messages.guides as Record<string, string>;

const title = block.metaTitle || block.title || "Гайды";
const description = block.metaDescription || block.subtitle || messages.meta.description;
const h1 = block.h1 || block.title || title;

const entries = GUIDES.map((guide) => {
  const content = getGuideContent(guide.contentKey, locale);
  return {
    slug: guide.slug,
    title: content?.h1 || content?.metaTitle || guide.slug,
    description: content?.subtitle || content?.metaDescription || "",
    related: guide.relatedLandings,
  };
});

const jsonLd = [
  webPageJsonLd({ name: h1, description, url: absoluteUrl("/guides"), locale }),
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: h1,
    numberOfItems: entries.length,
    itemListElement: entries.map((entry, index) => ({
      "@type": "ListItem",
      position: index + 1,
      url: absoluteUrl(`/guides/${entry.slug}`),
      name: entry.title,
    })),
  },
];
---

<BaseLayout
  title={title}
  description={description}
  locale={locale}
  canonicalPath="/guides"
  jsonLd={jsonLd}
>
  <article class="container-editorial py-12 md:py-20">
    <p class="meta-label">{messages.nav.guides}</p>
    <h1 class="mt-4 display-title">{h1}</h1>
    {description && <p class="mt-6 body-copy max-w-3xl">{description}</p>}

    <ul class="mt-10 grid gap-6 md:grid-cols-2">
      {
        entries.map((entry) => (
          <li class="border border-hairline p-5">
            <a class="font-medium text-ink text-link" href={localizePath(`/guides/${entry.slug}`, locale)}>
              {entry.title}
            </a>
            {entry.description && <p class="mt-2 text-sm text-muted">{entry.description}</p>}
          </li>
        ))
      }
    </ul>

    <div class="mt-12 flex flex-wrap gap-x-6 gap-y-2">
      <a class="link-more" href={localizePath("/services", locale)}>Каталог решений →</a>
      <a class="link-more" href={localizePath("/pricing", locale)}>Стоимость аудита и внедрения →</a>
      <a class="link-more" href={localizePath("/for-coo", locale)}>Операционному директору →</a>
    </div>
  </article>
</BaseLayout>
