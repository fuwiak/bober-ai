---
export const prerender = true;
import BaseLayout from "@/layouts/BaseLayout.astro";
import BeforeAfterDemo from "@/components/BeforeAfterDemo.astro";
import ContactForm from "@/components/ContactForm.astro";
import TrustStrip from "@/components/TrustStrip.astro";
import CaseStudyCard from "@/components/CaseStudyCard.astro";
import PackagesShowcase from "@/components/PackagesShowcase.astro";
import FaqSection from "@/components/FaqSection.astro";
import RoiCalculatorSection from "@/components/RoiCalculatorSection.astro";
import HomeAuthoritySections from "@/components/HomeAuthoritySections.astro";
import { loadMessages, localizePath } from "@/lib/i18n";
import { getEnterpriseServicesListing } from "@/lib/enterprise-services";
import { getPortfolioListing, PROFILE } from "@/lib/profile";
import { absoluteUrl } from "@/lib/site";
import {
  CONTACT_EMAIL,
  CONTACT_PHONE,
  FOUNDER_IMAGE,
  GITHUB_URL,
  LINKEDIN_URL,
  PRIMARY_CTA_GOAL,
  SITE_NAME,
  TELEGRAM_URL,
  WHATSAPP_URL,
  YANDEX_USLUGI_URL,
} from "@/lib/site";
import {
  localizedAbsolute,
  organizationJsonLd,
  personJsonLd,
  websiteJsonLd,
  siteNavigationJsonLd,
} from "@/lib/seo";

const locale = "ru" as const;
const messages = loadMessages(locale);
const meta = messages.meta;
const hero = messages.hero;
const founderAlt = hero.heroImageAlt || `${SITE_NAME} — Павел Стасиньски`;
const founder = messages.founderManifesto;
const trustStats = messages.trust.stats;
const trustBenefits = messages.trust.benefits;
const ba = messages.beforeAfterDemo;
const packageItems = messages.packages.items.map((item) => ({
  name: item.name,
  price: item.price,
  duration: item.duration,
  forWhom: item.forWhom,
  result: item.result,
  badge: "badge" in item ? (item.badge as string | undefined) : undefined,
  featured: "featured" in item ? Boolean(item.featured) : false,
  detailsHref: "detailsHref" in item ? (item.detailsHref as string | undefined) : undefined,
}));
const faqItems = messages.faq.items.slice(0, 4);
const caseStudies = getPortfolioListing(locale);
const smbCases = caseStudies.filter((item) => (item.segment ?? "smb") === "smb");
const enterpriseCases = caseStudies.filter((item) => item.segment === "enterprise");
const leadParagraphs = hero.valueProposition
  .split(/\n\n+/)
  .map((part) => part.trim())
  .filter(Boolean);
const services = getEnterpriseServicesListing(locale);
const offersJsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  itemListElement: services.map((offer, index) => ({
    "@type": "ListItem",
    position: index + 1,
    item: {
      "@type": "Offer",
      name: offer.title,
      price: offer.price,
      priceCurrency: "RUB",
      url: absoluteUrl(`/services/${offer.slug}`),
    },
  })),
};
const founderJsonLd = personJsonLd({
  name: PROFILE.name,
  jobTitle: PROFILE.roles[0],
  description: PROFILE.focus,
  image: PROFILE.heroImage,
  url: localizedAbsolute("/about", locale),
  sameAs: [LINKEDIN_URL, GITHUB_URL, TELEGRAM_URL, YANDEX_USLUGI_URL],
});
const homeJsonLd = [
  { "@context": "https://schema.org", ...organizationJsonLd(locale), description: meta.description },
  founderJsonLd,
  offersJsonLd,
  websiteJsonLd(locale),
  siteNavigationJsonLd(locale),
];
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  locale={locale}
  canonicalPath="/"
  keywords={meta.keywords}
  jsonLd={homeJsonLd}
>
  <section class="hero-section section-band">
    <div class="container-editorial hero-compose">
      <div class="hero-compose__copy">
        <p class="meta-label">{hero.location}</p>
        <h1 class="hero-title mt-4 hero-title--sentence hero-title--compact">{hero.titleLine1}</h1>
        {
          leadParagraphs.map((p) => (
            <p class="mt-4 body-copy max-w-2xl whitespace-pre-line">{p}</p>
          ))
        }
        <p class="mt-3 text-sm text-muted">{hero.differentiator}</p>
        {
          hero.trustItems?.length ? (
            <ul class="hero-trust mt-5 flex flex-wrap gap-2">
              {hero.trustItems.map((item) => (
                <li class="meta-label rounded border border-hairline px-3 py-1">{item}</li>
              ))}
            </ul>
          ) : null
        }
        <div class="mt-6 flex flex-wrap gap-4">
          <button type="button" class="btn-primary" data-contact-open data-contact-goal={PRIMARY_CTA_GOAL}>
            {messages.cta.primary}
          </button>
          <a href={localizePath("/#cases", locale)} class="btn-secondary">
            {hero.ctaSecondary}
          </a>
        </div>
      </div>

      <figure class="hero-compose__media">
        <div class="editorial-image editorial-image--hero hero-media__frame hero-media__portrait">
          <img
            src={FOUNDER_IMAGE}
            alt={founderAlt}
            class="hero-media__image"
            width="800"
            height="1000"
            fetchpriority="high"
            decoding="async"
          />
        </div>
        <figcaption class="sr-only">{founderAlt}</figcaption>
        <p class="meta-label mt-3">{founder.name} · {founder.role}</p>
        <dl class="hero-founder-stats">
          {
            founder.stats.map((stat) => (
              <div class="hero-founder-stats__item">
                <dt class="sr-only">{stat.label}</dt>
                <dd>
                  <span class="hero-founder-stats__value">{stat.value}</span>
                  <span class="hero-founder-stats__label">{stat.label}</span>
                </dd>
              </div>
            ))
          }
        </dl>
      </figure>
    </div>
  </section>

  <section class="section-band section--deep border-b border-hairline">
    <div class="container-editorial">
      <TrustStrip
        stats={trustStats}
        benefits={trustBenefits}
        partnersAriaLabel={messages.trust.partnersAriaLabel}
      />
    </div>
  </section>

  <BeforeAfterDemo
    label={ba.label}
    title={ba.title}
    subtitle={ba.subtitle}
    demoNote={ba.demoNote}
    beforeLabel={ba.beforeLabel}
    afterLabel={ba.afterLabel}
    beforeMetric={ba.beforeMetric}
    afterMetric={ba.afterMetric}
    beforeSteps={ba.beforeSteps}
    afterSteps={ba.afterSteps}
    flow={ba.flow}
  />

  <section id="cases" class="section-band section--panel scroll-mt-16 border-b border-hairline">
    <div class="container-editorial">
      <div class="reveal">
      <span class="section-label">{messages.homeLanding.casesLabel}</span>
      <h2 class="section-title mt-4">{messages.homeLanding.casesTitle}</h2>
      <p class="body-copy mt-4 max-w-2xl text-base">{messages.homeLanding.casesSubtitle}</p>
      </div>

      {
        smbCases.length > 0 && (
          <>
            <h3 class="mt-8 font-display text-2xl tracking-tight">{messages.portfolio.segmentSmbTitle}</h3>
            <div class="cases-grid cases-grid--smb mt-5">
              {smbCases.map((item) => (
                <CaseStudyCard
                  item={item}
                  locale={locale}
                  compact
                  segmentLabel={
                    item.kind === "solution"
                      ? messages.portfolio.kindSolution
                      : messages.portfolio.segmentSmb
                  }
                  viewLabel={messages.common.viewCaseStudy}
                  beforeLabel={messages.homeLanding.caseBeforeLabel}
                  afterLabel={messages.homeLanding.caseAfterLabel}
                />
              ))}
            </div>
          </>
        )
      }

      {
        enterpriseCases.length > 0 && (
          <>
            <h3 class="mt-10 font-display text-2xl tracking-tight">
              {messages.portfolio.segmentEnterpriseTitle}
            </h3>
            <div class="cases-grid mt-5">
              {enterpriseCases.map((item) => (
                <CaseStudyCard
                  item={item}
                  locale={locale}
                  compact
                  segmentLabel={messages.portfolio.segmentEnterprise}
                  viewLabel={messages.common.viewCaseStudy}
                  beforeLabel={messages.homeLanding.caseBeforeLabel}
                  afterLabel={messages.homeLanding.caseAfterLabel}
                />
              ))}
            </div>
          </>
        )
      }

      <div class="mt-8">
        <a href={localizePath("/portfolio", locale)} class="link-more">
          {messages.homeLanding.casesCta}
        </a>
      </div>
    </div>
  </section>

  <RoiCalculatorSection locale={locale} messages={messages} />

  <section class="section-band section--panel border-b border-hairline">
    <div class="container-editorial flex flex-wrap gap-x-8 gap-y-3">
      <a href={localizePath("/process-review", locale)} class="link-more">
        Разбор одного процесса — бесплатно →
      </a>
      <a href={localizePath("/audit", locale)} class="link-more">
        Пройти полный AI-аудит процесса за 5 минут →
      </a>
    </div>
  </section>

  <PackagesShowcase
    locale={locale}
    label={messages.sections.engagement}
    title={messages.packages.title}
    subtitle={messages.packages.subtitle}
    items={packageItems}
    featuredLabel={messages.packages.featuredLabel}
    detailsLabel={messages.packages.detailsLabel}
    cta={messages.cta.primary}
    moreHref="/pricing"
    moreLabel={messages.homeLanding.packagesMore}
  />

  <HomeAuthoritySections
    locale={locale}
    homeLanding={messages.homeLanding}
    partners={messages.partners}
  />

  <FaqSection
    locale={locale}
    label={messages.faq.label}
    title={messages.faq.title}
    subtitle={messages.faq.subtitle}
    items={faqItems}
    moreHref="/faq"
    moreLabel={messages.homeLanding.faqMore}
    pageUrl={absoluteUrl("/")}
    className="section--deep"
  />

  <section id="contact" class="section-band section--panel scroll-mt-16 border-t border-hairline pb-24 md:pb-16">
    <div class="container-editorial max-w-2xl">
      <div class="text-center">
        <span class="section-label">{messages.sections.contact}</span>
        <h2 class="section-title mt-4">{messages.contact.title}</h2>
        <p class="body-copy mt-4 text-base">{messages.contact.subtitle}</p>
        <p class="body-copy mt-3 text-sm text-muted">{messages.contact.afterSubmit}</p>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <a href={TELEGRAM_URL} target="_blank" rel="noreferrer" class="btn-secondary" data-goal="telegram_click">
            Telegram
          </a>
          <a href={WHATSAPP_URL} target="_blank" rel="noreferrer" class="btn-secondary" data-goal="modal_whatsapp_click">
            WhatsApp
          </a>
          <a href={`mailto:${CONTACT_EMAIL}`} class="btn-secondary" data-goal="email_click">Email</a>
          <a href={`tel:${CONTACT_PHONE}`} class="btn-secondary" data-goal="phone_click">{CONTACT_PHONE}</a>
        </div>
      </div>
      <div class="mt-10 text-left">
        <ContactForm locale={locale} messages={messages} qualify source="home-contact" />
      </div>
    </div>
  </section>
</BaseLayout>
