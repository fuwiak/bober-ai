---
/**
 * Kaspersky product page — press-release body + optional full-bleed hero
 * (soc-kuma-kira). Colors stay on Bober tokens.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import ContactForm from "@/components/ContactForm.astro";
import PartnerCertificates from "@/components/PartnerCertificates.astro";
import {
  getAllKasperskyProductSlugs,
  getKasperskyProduct,
  KASPERSKY_PRODUCTS,
} from "@/lib/kaspersky-page";
import { loadMessages, localizePath, type Locale } from "@/lib/i18n";
import { KASPERSKY_PARTNER_URL, SITE_NAME, TELEGRAM_URL } from "@/lib/site";
import {
  KASPERSKY_PARTNER_BADGES,
  KASPERSKY_PARTNER_CERTIFICATES,
  TRUST_PARTNERS,
} from "@/lib/trust-partners";

export const prerender = true;

export function getStaticPaths() {
  return getAllKasperskyProductSlugs().map((slug) => ({ params: { slug } }));
}

const locale = "ru" as Locale;
const { slug } = Astro.params;
const product = getKasperskyProduct(slug!);
if (!product) {
  throw new Error(`Unknown Kaspersky product: ${slug}`);
}
const messages = loadMessages(locale);
const others = KASPERSKY_PRODUCTS.filter((p) => p.slug !== slug).sort(
  (a, b) => a.priority - b.priority,
);
const title = product.metaTitleRu;
const description = product.metaDescRu;
const dek = product.dekRu ?? product.summaryRu;
const body = product.bodyRu ?? [];
const quote = product.quoteRu;
const contextDate = product.contextDateRu;
const hasHero = Boolean(product.heroImage);
const heroTitle = product.heroTitleRu ?? product.titleRu;
const kasperskyMark = TRUST_PARTNERS.find((p) => p.id === "kaspersky");
const crumbItems = [
  { name: "Secure AI", path: "/secure-ai" },
  { name: "Kaspersky", path: "/kaspersky" },
  { name: product.badgeRu, path: `/kaspersky/${slug}` },
];
---

<BaseLayout title={title} description={description} locale={locale} canonicalPath={`/kaspersky/${slug}`}>
  <main class="k-press">
    {
      hasHero ? (
        <section class="k-hero" aria-labelledby="k-hero-title">
          <div class="k-hero__plane" aria-hidden="true">
            <img
              src={product.heroImage}
              alt=""
              class="k-hero__image"
              width="1920"
              height="1080"
              fetchpriority="high"
              decoding="async"
            />
          </div>
          <div class="k-hero__veil" aria-hidden="true" />
          <div class="k-hero__inner">
            <Breadcrumbs locale={locale} items={crumbItems} />
            <p class="k-hero__brand">{SITE_NAME}</p>
            <h1 id="k-hero-title" class="k-hero__title">
              {heroTitle}
            </h1>
            <p class="k-hero__lead">{dek}</p>
            <div class="k-hero__actions">
              <a href="#contact" class="btn-primary" data-goal="primary_cta_click">
                Обсудить проект
              </a>
              <a href={TELEGRAM_URL} target="_blank" rel="noreferrer" class="btn-secondary">
                Telegram
              </a>
            </div>
            <div class="k-hero__partner" aria-label="Статус партнёра Kaspersky">
              {
                kasperskyMark ? (
                  <a href={KASPERSKY_PARTNER_URL} class="k-hero__partner-mark">
                    <img
                      src={kasperskyMark.logoSrc}
                      alt={kasperskyMark.name}
                      width={kasperskyMark.logoWidth}
                      height={kasperskyMark.logoHeight}
                      loading="eager"
                      decoding="async"
                    />
                  </a>
                ) : null
              }
              {
                KASPERSKY_PARTNER_BADGES.map((badge) => (
                  <a href={KASPERSKY_PARTNER_URL} class="k-hero__partner-badge">
                    <img
                      src={badge.src}
                      alt={badge.altRu}
                      width={badge.width}
                      height={badge.height}
                      loading="eager"
                      decoding="async"
                    />
                  </a>
                ))
              }
            </div>
          </div>
        </section>
      ) : null
    }

    <article class={`k-press__article${hasHero ? " k-press__article--after-hero" : ""}`}>
      {
        hasHero ? (
          contextDate ? (
            <header class="k-press__header k-press__header--compact">
              <p class="k-press__date k-press__date--flush">{contextDate}</p>
            </header>
          ) : null
        ) : (
          <header class="k-press__header">
            <Breadcrumbs locale={locale} items={crumbItems} />
            {contextDate ? (
              <p class="k-press__date">{contextDate}</p>
            ) : (
              <p class="k-press__date">{product.badgeRu}</p>
            )}
            <h1 class="k-press__title">{product.titleRu}</h1>
            <p class="k-press__dek">{dek}</p>
            <div class="k-press__actions">
              <a href="#contact" class="btn-primary" data-goal="primary_cta_click">
                Обсудить проект
              </a>
              <a href={TELEGRAM_URL} target="_blank" rel="noreferrer" class="btn-secondary">
                Telegram
              </a>
              <a href={localizePath("/kaspersky", locale)} class="btn-secondary">
                Все линии Kaspersky
              </a>
            </div>
          </header>
        )
      }

      {
        body.length > 0 ? (
          <div class="k-press__prose">
            {body.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
        ) : (
          <div class="k-press__prose">
            <p>{product.summaryRu}</p>
            <p>{product.fitRu}</p>
          </div>
        )
      }

      {
        quote ? (
          <blockquote class="k-press__quote">
            <p>{quote.text}</p>
            <footer>
              <cite>{quote.author}</cite>
              <span>{quote.role}</span>
            </footer>
          </blockquote>
        ) : null
      }

      <section class="k-press__band k-press__partner" aria-labelledby="partner-heading">
        <h2 id="partner-heading" class="k-press__h2">Партнёрство с «Лабораторией Касперского»</h2>
        <p class="k-press__fit">
          Registered Partner · B2B и B2C. Знаки и сертификаты — подтверждение статуса; поставка лицензий через официальную дистрибуцию.
        </p>
        <div class="partner-badge-row mt-8">
          {
            kasperskyMark ? (
              <a href={KASPERSKY_PARTNER_URL} class="partner-badge-frame partner-badge-frame--mark">
                <img
                  src={kasperskyMark.logoSrc}
                  alt={kasperskyMark.name}
                  width={kasperskyMark.logoWidth}
                  height={kasperskyMark.logoHeight}
                  class="partner-badge-image partner-badge-image--mark"
                  loading="lazy"
                  decoding="async"
                />
              </a>
            ) : null
          }
          {
            KASPERSKY_PARTNER_BADGES.map((badge) => (
              <a href={KASPERSKY_PARTNER_URL} class="partner-badge-frame">
                <img
                  src={badge.src}
                  alt={badge.altRu}
                  width={badge.width}
                  height={badge.height}
                  class="partner-badge-image"
                  loading="lazy"
                  decoding="async"
                />
              </a>
            ))
          }
        </div>
        {
          KASPERSKY_PARTNER_CERTIFICATES.length > 0 ? (
            <div class="mt-10">
              <h3 class="k-press__h3">Сертификаты сотрудничества</h3>
              <PartnerCertificates
                locale={locale}
                titles={{ b2b: "B2B", b2c: "B2C" }}
                openLabel="Открыть PDF"
              />
            </div>
          ) : null
        }
      </section>

      <section class="k-press__band" aria-labelledby="buy-heading">
        <h2 id="buy-heading" class="k-press__h2">Что получает заказчик</h2>
        <ul class="k-press__list">
          {product.clientBuysRu.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </section>

      <section class="k-press__split" aria-label="Зоны ответственности">
        <div>
          <h2 class="k-press__h2">Bober AI Systems</h2>
          <ul class="k-press__list">
            {product.boberScopeRu.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
        <div>
          <h2 class="k-press__h2">Kaspersky</h2>
          <ul class="k-press__list">
            {product.kasperskyScopeRu.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      </section>

      <section class="k-press__band" aria-labelledby="arch-heading">
        <h2 id="arch-heading" class="k-press__h2">Как устроен контур</h2>
        <ol class="k-press__flow">
          {product.architectureRu.map((step) => (
            <li>{step}</li>
          ))}
        </ol>
        <p class="k-press__fit">{product.fitRu}</p>
        {
          product.relatedHref ? (
            <p class="k-press__aside-link">
              <a href={localizePath(product.relatedHref, locale)} class="text-link">
                {product.relatedLabelRu}
              </a>
            </p>
          ) : null
        }
        {product.noteRu ? <p class="k-press__note">{product.noteRu}</p> : null}
        {product.sourceNoteRu ? <p class="k-press__note">{product.sourceNoteRu}</p> : null}
      </section>
    </article>

    <section class="k-press__related" aria-labelledby="related-heading">
      <div class="k-press__related-inner">
        <h2 id="related-heading" class="k-press__h2">Другие линии</h2>
        <ul class="k-press__related-grid">
          {
            others.map((item) => (
              <li>
                <a href={`/kaspersky/${item.slug}`} class="k-press__related-card">
                  <span class="k-press__related-badge">{item.badgeRu}</span>
                  <span class="k-press__related-title">{item.titleRu}</span>
                  <span class="k-press__related-summary">{item.summaryRu}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section id="contact" class="k-press__contact">
      <div class="k-press__contact-inner">
        <h2 class="k-press__h2">Запрос</h2>
        <p class="k-press__contact-lead">
          Имя и контакт — достаточно для первого шага. Описание задачи необязательно.
        </p>
        <div class="k-press__form">
          <ContactForm locale={locale} messages={messages} defaultService={product.titleRu} />
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
