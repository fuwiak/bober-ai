---
/**
 * KZ «AI for business» — SeoServicePage + getIiDlyaBiznesaSeoContent.
 */
import SeoServicePage from "@/components/SeoServicePage.astro";
import { II_DLYA_BIZNESA_PAGE, getIiDlyaBiznesaSeoContent } from "@/lib/ii-dlya-biznesa-page";

export const prerender = true;

const locale = "kz" as const;
const content = getIiDlyaBiznesaSeoContent(locale);
const p = II_DLYA_BIZNESA_PAGE;
---

