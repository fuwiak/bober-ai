---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ContactForm from "@/components/ContactForm.astro";
import { loadMessages, localizePath } from "@/lib/i18n";
import { getPortfolioListing } from "@/lib/profile";

export const prerender = true;

const locale = "kz" as const;
const messages = loadMessages(locale);
const page = messages.pages?.portfolio ?? messages.portfolio;
const items = getPortfolioListing(locale);
const title = page?.metaTitle || page?.title || messages.nav.portfolio;
---

<BaseLayout
  title={title}
  description={page?.metaDescription || page?.subtitle || messages.meta.description}
  locale={locale}
  canonicalPath="/kz/portfolio"
>
  <section class="container-editorial py-12 md:py-20">
    <h1 class="display-title">{page?.title || messages.nav.portfolio}</h1>
    {page?.subtitle && <p class="mt-6 body-copy max-w-3xl">{page.subtitle}</p>}
    <ul class="mt-12 grid gap-6 md:grid-cols-2">
      {
        items.map((item) => (
          <li class="group border border-hairline overflow-hidden">
            <a class="block" href={localizePath(`/portfolio/${item.slug}`, locale)}>
              {item.image && (
                <div class="editorial-image editorial-image--card relative aspect-[16/10] bg-surface-soft">
                  <img
                    src={item.image}
                    alt={item.imageAlt || item.title}
                    class="case-study__image object-cover"
                    width="800"
                    height="500"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              )}
              <div class="p-5">
                <p class="font-medium text-link">{item.title}</p>
                {item.description && <p class="mt-2 text-sm text-muted">{item.description}</p>}
                {item.metric && <p class="mt-3 text-xs text-accent">{item.metric}</p>}
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
  <section id="contact" class="container-editorial py-16 border-t border-hairline">
    <h2 class="section-title">{messages.nav.contact}</h2>
    <div class="mt-8 max-w-xl"><ContactForm locale={locale} messages={messages} /></div>
  </section>
</BaseLayout>
