---
/**
 * EN service offer pages — Next parity via SeoServicePage + getAllServiceSlugs.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import ContactForm from "@/components/ContactForm.astro";
import SeoServicePage from "@/components/SeoServicePage.astro";
import { getEnterpriseService } from "@/lib/enterprise-services";
import { loadMessages, type Locale } from "@/lib/i18n";
import { PROFILE } from "@/lib/profile";
import { getAllServiceSlugs, getSeoServiceContent } from "@/lib/seo-services-content";
import { TELEGRAM_URL } from "@/lib/site";

export const prerender = true;

export function getStaticPaths() {
  return getAllServiceSlugs("kz").map((slug) => ({
    params: { slug },
    props: { locale: "kz" as Locale },
  }));
}

const { slug } = Astro.params;
const locale = "kz" as const;
const messages = loadMessages(locale);
const sp = messages.servicePage;
const content = getSeoServiceContent(slug!, "kz");
const service = getEnterpriseService(slug!, locale);

if (!content && !service) {
  return Astro.redirect("/kz/services");
}
---

{
  content ? (
    <SeoServicePage slug={slug!} locale={locale} content={content} />
  ) : (
    <BaseLayout
      title={`${service!.title} — Bober AI`}
      description={service!.description}
      locale={locale}
      canonicalPath={`/kz/services/${service!.slug}`}
    >
      <article class="container-editorial py-12 md:py-20">
        <p class="meta-label">{messages.nav.services}</p>
        <h1 class="mt-4 display-title">{service!.title}</h1>
        <p class="mt-3 text-sm text-muted">
          Performer: <span class="font-medium text-ink">{PROFILE.name}</span>
        </p>
        <figure class="landing-hero-media mt-10 editorial-image editorial-image--hero overflow-hidden rounded">
          <img
            src={service!.serviceImage}
            alt={service!.title}
            class="hero-media__image h-full w-full object-cover"
            width="1400"
            height="600"
            fetchpriority="high"
            decoding="async"
          />
        </figure>
        <p class="mt-6 body-copy max-w-3xl">{service!.description}</p>
        <div class="feature-card mt-8 max-w-3xl">
          <h2 class="font-display text-xl tracking-tight">{sp.includes}</h2>
          <p class="mt-3 text-sm leading-relaxed text-body">{service!.about}</p>
          <ul class="mt-4 list-disc space-y-1 pl-5 text-sm text-body">
            {sp.deliverables.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
        <aside class="feature-card-bordered mt-10 max-w-sm">
          <p class="font-display text-2xl tracking-tight">{service!.salesNotes}</p>
          <p class="mt-1 text-sm text-muted">
            {sp.timeline}: {service!.deliveryDays} {sp.days}
          </p>
          <div class="mt-5 flex flex-col gap-2">
            <a href="#contact" class="btn-primary text-center">
              {sp.quote}
            </a>
            <a href={TELEGRAM_URL} target="_blank" rel="noreferrer" class="btn-secondary text-center">
              {sp.telegram}
            </a>
          </div>
        </aside>
        <section id="contact" class="mt-16 border-t border-hairline pt-12">
          <h2 class="section-title">{sp.formTitle}</h2>
          <div class="mt-8 max-w-xl">
            <ContactForm locale={locale} messages={messages} defaultService={service!.title} />
          </div>
        </section>
      </article>
    </BaseLayout>
  )
}
