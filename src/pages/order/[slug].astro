---
/**
 * Explicit order page for Yandex performers feed «Ссылка на создание заказа».
 * Separate from estimate modal («Получить оценку проекта»).
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import ContactForm from "@/components/ContactForm.astro";
import { getEnterpriseService, getEnterpriseServices } from "@/lib/enterprise-services";
import { loadMessages, localizePath, type Locale } from "@/lib/i18n";
import { getServiceOfferUrl } from "@/lib/services-feed";
import { TELEGRAM_URL } from "@/lib/site";

export const prerender = true;

export function getStaticPaths() {
  return getEnterpriseServices("ru").map((service) => ({
    params: { slug: service.slug },
    props: { locale: "ru" as Locale },
  }));
}

const { slug } = Astro.params;
const { locale } = Astro.props;
const messages = loadMessages(locale);
const service = getEnterpriseService(slug!, locale);

if (!service) {
  return Astro.redirect(localizePath("/order", locale));
}

const offerUrl = getServiceOfferUrl(service);
const offerPath = offerUrl.replace(/^https?:\/\/[^/]+/, "") || `/services/${service.slug}`;
const estimateHref = `${localizePath(offerPath, locale)}#estimate`;
const priceLabel = `от ${service.price.toLocaleString("ru-RU")} ₽`;
const pageTitle = `Заказ «${service.title}» (${priceLabel}) — онлайн-форма | Bober AI`;
const pageDescription = [
  `Оформление заказа услуги «${service.title}».`,
  service.description.replace(/\s+/g, " ").trim(),
  `Срок от ${service.deliveryDays} дн., ${priceLabel}.`,
]
  .join(" ")
  .slice(0, 160);
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  locale={locale}
  canonicalPath={localizePath(`/order/${service.slug}`, locale)}
  noIndex
>
  <article class="container-editorial py-12 md:py-20">
    <p class="meta-label">{messages.order.metaLabel}</p>
    <h1 class="mt-4 display-title">{messages.order.title}</h1>
    <p class="mt-4 body-copy max-w-2xl">{messages.order.subtitle}</p>
    <p class="mt-4 body-copy max-w-2xl">
      Услуга: <strong class="text-ink">{service.title}</strong>
      {" · "}
      {service.salesNotes}
      {" · от "}
      {service.price.toLocaleString("ru-RU")} ₽
    </p>
    <p class="mt-3 text-sm text-muted max-w-2xl">{service.description}</p>

    <div class="mt-6 flex flex-wrap gap-3">
      <a href={localizePath(offerPath, locale)} class="btn-secondary">Описание услуги</a>
      <a href={TELEGRAM_URL} target="_blank" rel="noreferrer" class="btn-secondary">Telegram</a>
      <button type="button" class="btn-secondary" data-contact-open data-contact-goal="estimate_from_order">
        {messages.contact.fabLabel}
      </button>
    </div>

    <section id="order" class="mt-12 max-w-xl border-t border-hairline pt-10">
      <h2 class="section-title">{messages.order.title}</h2>
      <p class="mt-3 body-copy text-sm text-muted">{messages.order.sectionHint}</p>
      <div class="mt-8">
        <ContactForm
          locale={locale}
          messages={messages}
          intent="order"
          defaultService={service.title}
          source={`order-${service.slug}`}
          qualify
        />
      </div>
      <p class="mt-8 text-sm text-muted">
        {messages.order.estimateCta}
        {" "}
        <a class="text-link" href={estimateHref}>{messages.order.estimateLink}</a>
        {" · "}
        <button type="button" class="text-link" data-contact-open data-contact-goal="estimate_from_order">
          {messages.contact.title}
        </button>
      </p>
    </section>
  </article>
</BaseLayout>
