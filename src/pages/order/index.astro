---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ContactForm from "@/components/ContactForm.astro";
import { getEnterpriseServices } from "@/lib/enterprise-services";
import { loadMessages, localizePath, type Locale } from "@/lib/i18n";

export const prerender = true;

const locale: Locale = "ru";
const messages = loadMessages(locale);
const services = getEnterpriseServices(locale);
---

const pageTitle = "Каталог заказов AI и автоматизации — Bober AI";
const pageDescription =
  "Онлайн-заказ услуг Bober AI: автоматизация процессов, CRM, документы, RAG и LLM. Выберите услугу, оставьте контакты — подтвердим состав работ и сроки.";
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  locale={locale}
  canonicalPath={localizePath("/order", locale)}
>
  <article class="container-editorial py-12 md:py-20">
    <p class="meta-label">{messages.order.metaLabel}</p>
    <h1 class="mt-4 display-title">{messages.order.title}</h1>
    <p class="mt-4 body-copy max-w-2xl">{messages.order.subtitle}</p>
    <p class="mt-3 body-copy text-sm text-muted max-w-2xl">{messages.order.sectionHint}</p>

    <p class="mt-6 text-sm">
      {messages.order.estimateCta}
      {" "}
      <button type="button" class="text-link" data-contact-open data-contact-goal="estimate_from_order">
        {messages.contact.title}
      </button>
    </p>

    <section class="mt-10">
      <h2 class="section-title">Услуги</h2>
      <ul class="mt-6 grid gap-3 sm:grid-cols-2">
        {
          services.slice(0, 24).map((s) => (
            <li>
              <a class="text-link" href={localizePath(`/order/${s.slug}`, locale)}>
                {s.title}
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section id="order" class="mt-14 max-w-xl border-t border-hairline pt-10">
      <h2 class="section-title">{messages.order.title}</h2>
      <div class="mt-8">
        <ContactForm locale={locale} messages={messages} intent="order" source="order-index" qualify />
      </div>
    </section>
  </article>
</BaseLayout>
