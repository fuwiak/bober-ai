---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { fetchOutageFeed } from "@/lib/outages-feed";
import { DEFAULT_KEYWORDS, SITE_NAME, absoluteUrl } from "@/lib/site";

export const prerender = false;

const title = "Аварии Yandex Cloud";
const description =
  "Лента оповещений о проблемах с доступностью и восстановлении сервисов Yandex Cloud.";
const keywords = [...DEFAULT_KEYWORDS, "Yandex Cloud аварии", "Yandex Cloud alerts", "статус сервисов"];

function formatDate(iso?: string): string {
  if (!iso) return "";
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return "";
  return new Intl.DateTimeFormat("ru-RU", {
    day: "2-digit",
    month: "2-digit",
    year: "numeric",
    hour: "2-digit",
    minute: "2-digit",
  }).format(d);
}

const items = await fetchOutageFeed();

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: SITE_NAME, item: absoluteUrl("/") },
    { "@type": "ListItem", position: 2, name: "Аварии Yandex Cloud", item: absoluteUrl("/outages") },
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  locale="ru"
  canonicalPath="/outages"
  keywords={keywords}
  jsonLd={breadcrumbJsonLd}
>
  <section class="container-editorial py-12 md:py-20">
    <div class="mb-10 flex flex-wrap items-center justify-between gap-4">
      <div>
        <p class="meta-label">Мониторинг</p>
        <h1 class="mt-2 display-title">Аварии</h1>
        <p class="mt-3 max-w-2xl body-copy text-muted">
          Оповещение пользователей Yandex Cloud о проблемах с доступностью и восстановлении
          работоспособности сервисов.
        </p>
      </div>
      <a href="/" class="btn-secondary text-sm uppercase tracking-widest">На главную</a>
    </div>

    <div class="mb-6 border border-hairline bg-surface p-4 text-sm text-muted">
      Источник:{" "}
      <a
        href="https://t.me/yandexcloudalerts"
        target="_blank"
        rel="noreferrer"
        class="font-semibold text-link underline-offset-4 hover:underline"
      >
        Yandex Cloud Alerts
      </a>
    </div>

    {
      items.length > 0 ? (
        <div class="space-y-4">
          {items.map((item) => (
            <a
              href={item.url}
              target="_blank"
              rel="noreferrer"
              class="block border border-hairline bg-surface p-5 transition hover:border-primary/40"
            >
              <p class="whitespace-pre-line">{item.text}</p>
              <div class="mt-3 text-xs uppercase tracking-widest text-muted">
                {formatDate(item.publishedAt) || "Telegram"}
              </div>
            </a>
          ))}
        </div>
      ) : (
        <div class="border border-hairline bg-surface p-8 text-center text-muted">
          Лента оповещений временно недоступна. Проверьте канал по ссылке выше.
        </div>
      )
    }
  </section>
</BaseLayout>
