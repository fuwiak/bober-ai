---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ContactForm from "@/components/ContactForm.astro";
import { loadMessages, type Locale } from "@/lib/i18n";
import { getPortfolioItem, getPortfolioListing } from "@/lib/profile";

export const prerender = true;

export function getStaticPaths() {
  return getPortfolioListing("ru").map((item) => ({
    params: { slug: item.slug },
    props: { locale: "ru" as Locale },
  }));
}

const { slug } = Astro.params;
const locale = "ru" as const;
const messages = loadMessages(locale);
const item = getPortfolioItem(slug!, locale);
if (!item) return Astro.redirect("/portfolio");
---

<BaseLayout
  title={`${item.title} — Bober AI`}
  description={item.description || messages.meta.description}
  locale={locale}
  canonicalPath={`/portfolio/${item.slug}`}
>
  <article class="container-editorial py-12 md:py-20">
    <p class="meta-label">{messages.nav.portfolio}</p>
    <h1 class="mt-4 display-title">{item.title}</h1>
    {item.subtitle && <p class="mt-3 body-copy max-w-3xl text-muted">{item.subtitle}</p>}
    {item.metric && <p class="mt-4 text-accent">{item.metric}</p>}
    {
      item.image && (
        <figure class="mt-10">
          <div class="landing-hero-media editorial-image editorial-image--hero relative aspect-[16/10] overflow-hidden rounded bg-surface-soft">
            <img
              src={item.image}
              alt={item.imageAlt || item.title}
              class={`hero-media__image h-full w-full ${
                item.image.endsWith(".svg") ? "object-contain" : "object-cover"
              }`}
              width="1400"
              height="875"
              fetchpriority="high"
              decoding="async"
            />
          </div>
          {item.imageCaption && <figcaption class="mt-3 text-sm text-muted">{item.imageCaption}</figcaption>}
        </figure>
      )
    }
    {item.description && (
      <section class="mt-10">
        <h2 class="section-title">{messages.portfolio.problemLabel}</h2>
        <p class="mt-4 body-copy max-w-3xl">{item.description}</p>
      </section>
    )}
    {item.solution && (
      <section class="mt-10">
        <h2 class="section-title">{messages.portfolio.solutionLabel}</h2>
        <p class="mt-4 body-copy max-w-3xl whitespace-pre-line">{item.solution}</p>
      </section>
    )}
    {item.result && (
      <section class="mt-10">
        <h2 class="section-title">{messages.portfolio.resultLabel}</h2>
        <p class="mt-4 body-copy max-w-3xl whitespace-pre-line">{item.result}</p>
      </section>
    )}
    {item.architecture && (
      <section class="mt-10">
        <h2 class="section-title">{messages.portfolio.architectureLabel}</h2>
        <p class="mt-4 font-mono text-sm md:text-base leading-relaxed text-ink max-w-3xl rounded bg-surface-soft px-4 py-3 border border-hairline">
          {item.architecture}
        </p>
      </section>
    )}
    {item.processSteps && item.processSteps.length > 0 && (
      <section class="mt-10">
        <h2 class="section-title">{messages.portfolio.processLabel}</h2>
        <ol class="mt-4 max-w-3xl list-decimal space-y-2 pl-5 body-copy">
          {item.processSteps.map((step) => (
            <li>{step}</li>
          ))}
        </ol>
      </section>
    )}
    {item.productionNotes && item.productionNotes.length > 0 && (
      <section class="mt-10">
        <h2 class="section-title">{messages.portfolio.productionLabel}</h2>
        <ul class="mt-4 max-w-3xl list-disc space-y-2 pl-5 body-copy">
          {item.productionNotes.map((note) => (
            <li>{note}</li>
          ))}
        </ul>
      </section>
    )}
    {item.stack && (
      <p class="mt-10 meta-label">{messages.portfolio.stackLabel}: {item.stack}</p>
    )}
    <section id="contact" class="mt-16 border-t border-hairline pt-12">
      <h2 class="section-title">{messages.nav.contact}</h2>
      <div class="mt-8 max-w-xl">
        <ContactForm
          locale={locale}
          messages={messages}
          defaultService={item.title}
          source={`portfolio-${item.slug}`}
        />
      </div>
    </section>
  </article>
</BaseLayout>
