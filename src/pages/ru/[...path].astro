---
/**
 * Next parity: /ru/:path* → /:path* (permanent).
 * Dynamic catch-all; not prerendered — redirects at request time.
 */
export const prerender = false;

const slug = Astro.params.path;
const rest = Array.isArray(slug) ? slug.join("/") : slug || "";
const dest = rest ? `/${rest}` : "/";
return Astro.redirect(dest, 301);
---
