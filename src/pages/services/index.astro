---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ContactForm from "@/components/ContactForm.astro";
import { loadMessages, localizePath } from "@/lib/i18n";
import { getEnterpriseServicesListing } from "@/lib/enterprise-services";

export const prerender = true;

const locale = "ru" as const;
const messages = loadMessages(locale);
const page = messages.pages?.services ?? messages.services;
const services = getEnterpriseServicesListing(locale);
const title = page?.metaTitle || page?.title || messages.nav.services;
const description = page?.metaDescription || page?.subtitle || messages.meta.description;
---

<BaseLayout title={title} description={description} locale={locale} canonicalPath="/services">
  <section class="container-editorial py-12 md:py-20">
    <h1 class="display-title">{page?.title || messages.nav.services}</h1>
    {page?.subtitle && <p class="mt-6 body-copy max-w-3xl">{page.subtitle}</p>}
    <ul class="mt-12 grid gap-6 md:grid-cols-2">
      {
        services.map((service) => (
          <li class="group border border-hairline overflow-hidden">
            <a href={localizePath(`/services/${service.slug}`, locale)} class="block">
              <div class="editorial-image editorial-image--card relative aspect-[16/10] bg-surface-soft">
                <img
                  src={service.serviceImage}
                  alt=""
                  class="case-study__image object-cover"
                  width="800"
                  height="500"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="p-5">
                <p class="font-medium text-link">{service.title}</p>
                <p class="mt-2 text-sm text-muted">{service.description}</p>
                <p class="mt-3 text-xs text-muted-soft">{service.salesNotes}</p>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
  <section id="contact" class="container-editorial py-16 border-t border-hairline">
    <h2 class="section-title">{messages.nav.contact}</h2>
    <div class="mt-8 max-w-xl"><ContactForm locale={locale} messages={messages} /></div>
  </section>
</BaseLayout>
