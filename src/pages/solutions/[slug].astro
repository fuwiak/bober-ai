---
/**
 * Solutions landings: rich SeoServicePage when content exists (e.g. rag-search),
 * otherwise compact SeoLanding from catalog.
 */
import SeoLanding from "@/components/SeoLanding.astro";
import SeoServicePage from "@/components/SeoServicePage.astro";
import { LANDING_PAGES } from "@/lib/landing-pages";
import type { Locale } from "@/lib/i18n";
import { getSeoServiceContent } from "@/lib/seo-services-content";

export const prerender = true;

export function getStaticPaths() {
  return LANDING_PAGES.filter((p) => p.category === "solutions").map((page) => ({
    params: { slug: page.slug },
    props: { page, locale: "ru" as Locale },
  }));
}

const { page, locale } = Astro.props;
const content = getSeoServiceContent(page.slug, locale === "uz" ? "uz" : "ru");
const path = `/solutions/${page.slug}`;
const solutionsLabel = locale === "uz" ? "Yechimlar" : "Решения";
/** Prefer commercial offer tied to feed path (e.g. rag for /solutions/rag-search). */
const offerSlug = page.slug === "rag-search" ? "rag" : page.serviceSlug;
---

{
  content ? (
    <SeoServicePage
      slug={page.slug}
      locale={locale}
      content={content}
      pagePath={path}
      serviceSlug={offerSlug}
      formSource={`solutions-${page.slug}`}
      formDefaultService={content.h1}
      breadcrumbItems={[
        { name: solutionsLabel, path: "/solutions" },
        { name: content.h1, path },
      ]}
    />
  ) : (
    <SeoLanding page={page} locale={locale} />
  )
}
