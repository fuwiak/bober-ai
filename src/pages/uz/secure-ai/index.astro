---
/**
 * EN Secure AI landing — content from SECURE_AI_PAGE (Next parity).
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import ContactForm from "@/components/ContactForm.astro";
import SecureAiChecklist from "@/components/SecureAiChecklist.astro";
import { getEnterpriseReviews } from "@/lib/enterprise-reviews";
import { getEnterpriseService } from "@/lib/enterprise-services";
import { loadMessages, localizePath, type Locale } from "@/lib/i18n";
import { PROFILE } from "@/lib/profile";
import { getSecureAiProductLinks, SECURE_AI_PAGE } from "@/lib/secure-ai-page";
import { faqJsonLd, localizedAbsolute, webPageJsonLd } from "@/lib/seo";
import { TELEGRAM_URL } from "@/lib/site";
import { KASPERSKY_PARTNER_CERTIFICATES } from "@/lib/trust-partners";

export const prerender = true;

const locale = "uz" as Locale;
const messages = loadMessages(locale);
const sp = messages.servicePage;
const p = SECURE_AI_PAGE;
const products = getSecureAiProductLinks();
const pack = getEnterpriseService("secure-private-ai-cloud", locale);
const reviews = getEnterpriseReviews();
const pageUrl = localizedAbsolute("/secure-ai", locale);
const h1 = p.h1En;
const subtitle = p.subtitleEn;
const processSteps = p.processEn;
const processTitles = ["Contour audit", "Pick a line", "Deployment", "Monitoring"] as const;
const roi = [
  { value: "5 lines", label: "LLM/RAG, DevOps, SOC, Gateway, mail" },
  { value: "25 checks", label: "express AI readiness checklist" },
  { value: "from 28 days", label: "Secure Private AI Cloud pack" },
] as const;
const related = [
  { href: p.packHref, label: p.packLabelEn },
  { href: p.kasperskyHref, label: p.kasperskyLabelEn },
  { href: "/ai-kubernetes", label: "AI on Kubernetes" },
  { href: "/services/rag", label: "Corporate RAG" },
  { href: "/services/ai-sales-loop", label: "AI sales loop (telephony+CRM)" },
];
const HERO_IMAGE = "/stock/cyber-padlock.jpg";
const jsonLd = [
  webPageJsonLd({
    name: p.metaTitleEn,
    description: p.metaDescEn,
    url: pageUrl,
    locale,
  }),
  faqJsonLd(
    p.faqEn.map((item) => ({ q: item.q, a: item.a })),
    pageUrl,
  ),
];
---

<BaseLayout
  title={p.metaTitleEn}
  description={p.metaDescEn}
  locale={locale}
  canonicalPath="/uz/secure-ai"
  jsonLd={jsonLd}
>
  <main>
    <section class="section-band section--deep border-b border-hairline">
      <div class="container-editorial">
        <Breadcrumbs locale={locale} items={[{ name: "Secure AI", path: "/secure-ai" }]} />
        <div class="mt-8 grid gap-12 lg:grid-cols-[1fr_360px] lg:items-start">
          <div class="max-w-4xl">
            <span class="section-label">{p.lineEn} · {p.parentEn}</span>
            <h1 class="display-md mt-4">{h1}</h1>
            <p class="mt-3 text-sm text-muted">
              Performer: <span class="font-medium text-ink">{PROFILE.name}</span>
            </p>
            <p class="body-copy mt-5 max-w-3xl text-lg">{subtitle}</p>
            <div class="mt-10 flex flex-wrap gap-4">
              <a href="#contact" class="btn-primary" data-goal="audit_cta_click"
                >Get an express architecture review</a
              >
              <a
                href={TELEGRAM_URL}
                target="_blank"
                rel="noreferrer"
                class="btn-secondary"
                data-goal="telegram_click">Telegram</a
              >
              <a href="#contact" class="btn-secondary" data-goal="service_estimate_cta_click"
                >Get an estimate</a
              >
            </div>
          </div>
          <aside class="feature-card-bordered">
            <p class="font-display text-2xl tracking-tight">
              {pack?.salesNotes ?? "from €8,000"}
            </p>
            <p class="mt-2 text-sm text-muted">
              {sp.timeline}: {pack?.deliveryDays ?? 28} {sp.days}
            </p>
            <p class="mt-3 text-sm text-muted">Fixed estimate · remote</p>
            <div
              class="relative mt-6 aspect-[4/3] overflow-hidden rounded-lg border border-hairline bg-surface-soft"
            >
              <img
                src={HERO_IMAGE}
                alt={h1}
                class="h-full w-full object-cover"
                width="360"
                height="270"
                fetchpriority="high"
                decoding="async"
              />
            </div>
            <a href="#contact" class="btn-primary mt-6 w-full text-center" data-goal="audit_cta_click"
              >{sp.quote}</a
            >
          </aside>
        </div>
      </div>
    </section>

    <section class="section-band section--panel border-b border-hairline">
      <div class="container-editorial max-w-3xl">
        <p class="body-copy text-base">
          Check whether your AI service is ready for corporate data — before launching an LLM, RAG or
          agent.
        </p>
      </div>
    </section>

    <section class="section-band section--deep border-b border-hairline">
      <div class="container-editorial grid gap-16 lg:grid-cols-2">
        <div>
          <h2 class="section-title">{p.mainBrandTitleEn}</h2>
          <ul class="mt-8 space-y-4">
            {
              p.mainBrandEn.map((item) => (
                <li class="body-copy flex gap-4 text-base">
                  <span class="meta-label shrink-0">—</span>
                  <span>{item}</span>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <h2 class="section-title">{p.lineTitleEn}</h2>
          <ul class="mt-8 space-y-4">
            {
              p.lineScopeEn.map((item) => (
                <li class="body-copy flex gap-4 text-base">
                  <span class="meta-label shrink-0">—</span>
                  <span>{item}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <section class="section-band section--panel border-b border-hairline">
      <div class="container-editorial">
        <h2 class="section-title">{p.processTitleEn}</h2>
        <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
          {
            processSteps.map((step, index) => (
              <article class="feature-card">
                <span class="font-display text-3xl text-primary/40">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <h3 class="card-title mt-3">{processTitles[index]}</h3>
                <p class="body-copy mt-3 text-base">{step}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section-band section--deep border-b border-hairline">
      <div class="container-editorial">
        <h2 class="section-title">Product lines</h2>
        <p class="body-copy mt-4 max-w-2xl text-base">
          Commercial subpages on the Kaspersky hub — LLM/RAG wired to security products.
        </p>
        <div class="mt-10 grid gap-6 md:grid-cols-2">
          {
            products.map((product) => (
              <article class="feature-card h-full">
                <span class="meta-label">{product.badgeEn}</span>
                <h3 class="card-title mt-3">
                  <a href={localizePath(product.href, locale)} class="hover:text-primary">
                    {product.titleEn}
                  </a>
                </h3>
                <p class="body-copy mt-3 text-base">{product.summaryEn}</p>
                <a href={localizePath(product.href, locale)} class="link-more mt-4">
                  Details
                </a>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section-band section--panel border-b border-hairline">
      <div class="container-editorial">
        <h2 class="section-title">Line impact</h2>
        <div class="mt-10 grid gap-6 sm:grid-cols-3">
          {
            roi.map((item) => (
              <div class="feature-card-bordered text-center">
                <p class="font-display text-3xl tracking-tight text-ink">{item.value}</p>
                <p class="body-copy mt-2 text-sm">{item.label}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section-band section--deep border-b border-hairline">
      <div class="container-editorial max-w-3xl">
        <span class="section-label">Express self-check</span>
        <h2 class="section-title mt-4">Is your AI service ready to handle corporate data?</h2>
        <p class="body-copy mt-4 max-w-2xl text-base">
          25 questions to check before launching a corporate LLM, RAG or AI agent.
        </p>
        <div class="mt-8">
          <SecureAiChecklist locale={locale} />
        </div>
      </div>
    </section>

    <section class="section-band section--panel border-b border-hairline">
      <div class="container-editorial max-w-3xl">
        <h2 class="section-title">{p.trustTitleEn}</h2>
        <p class="body-copy mt-3 max-w-2xl text-base">{p.trustIntroEn}</p>
        <div class="mt-8 grid gap-4 sm:grid-cols-2">
          {
            KASPERSKY_PARTNER_CERTIFICATES.map((cert) => (
              <a
                href={cert.pdfSrc}
                target="_blank"
                rel="noreferrer"
                class="feature-card block transition hover:border-primary/40"
              >
                <div class="bg-white p-3">
                  <img
                    src={cert.previewSrc}
                    alt={cert.altEn}
                    width="400"
                    height="283"
                    class="w-full rounded-sm"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <span class="mt-2 inline-block text-xs text-link">PDF</span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    {
      reviews.length > 0 && (
        <section class="section-band section--panel border-b border-hairline">
          <div class="container-editorial">
            <span class="section-label">Trust</span>
            <h2 class="section-title mt-4">Reviews from Yandex</h2>
            <div class="mt-10 grid gap-6 md:grid-cols-2">
              {reviews.map((review) => (
                <blockquote class="feature-card">
                  <p class="body-copy text-base">“{review.text}”</p>
                  <footer class="mt-4 text-sm text-muted">
                    — {review.author}
                    {review.date ? ` · ${review.date}` : ""} · {review.source}
                  </footer>
                </blockquote>
              ))}
            </div>
          </div>
        </section>
      )
    }

    <section class="section-band section--panel border-b border-hairline">
      <div class="container-editorial max-w-3xl">
        <h2 class="section-title">FAQ</h2>
        <dl class="mt-8 space-y-8">
          {
            p.faqEn.map((item) => (
              <div>
                <dt class="font-display text-xl tracking-tight">{item.q}</dt>
                <dd class="body-copy mt-3 text-base">{item.a}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <section class="section-band section--deep border-b border-hairline">
      <div class="container-editorial">
        <h2 class="section-title">Related services</h2>
        <ul class="mt-6 space-y-2">
          {
            related.map((item) => (
              <li>
                <a href={localizePath(item.href, locale)} class="link-more py-2">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section id="contact" class="section-band section--panel scroll-mt-16">
      <div class="container-editorial grid gap-16 lg:grid-cols-2">
        <div>
          <span class="section-label">Contact</span>
          <h2 class="section-title mt-4">{sp.formTitle}</h2>
          <p class="body-copy mt-4 max-w-xl text-base">{subtitle}</p>
        </div>
        <ContactForm locale={locale} messages={messages} defaultService="Bober Secure AI" />
      </div>
    </section>
  </main>
</BaseLayout>
